---
import Layout from "@/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import TeamGroupSection from "@/components/team/TeamGroupSection.astro";
import { TEAM_GROUPS, type TeamGroup } from "@/content.config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection("team");

const byGroup = Object.fromEntries(
  TEAM_GROUPS.map((g) => [g, all.filter((m) => m.data.groups.includes(g))]),
) as Record<TeamGroup, CollectionEntry<"team">[]>;

const groupTitles = Object.fromEntries(
  TEAM_GROUPS.map((g) => [g, t(`team.group.${g}` as const)]),
) as Record<TeamGroup, string>;

const groupIntros = Object.fromEntries(
  TEAM_GROUPS.map((g) => [g, t(`team.intro.${g}` as const)]),
) as Record<TeamGroup, string>;

const hasAnyMember = all.length > 0;
---

<Layout title={t("team.page.title")} lang={lang}>
  <main class="mx-auto max-w-7xl px-4 md:px-6 py-24">
    <header class="text-center">
      <h1 class="text-4xl font-bold text-foreground">{t("team.page.title")}</h1>
      <p class="mt-4 text-base text-muted-foreground max-w-2xl mx-auto">
        {t("team.page.intro")}
      </p>
    </header>

    {
      hasAnyMember ? (
        TEAM_GROUPS.map((g) =>
          byGroup[g].length > 0 ? (
            <TeamGroupSection
              members={byGroup[g]}
              lang={lang}
              title={groupTitles[g]}
              intro={groupIntros[g]}
            />
          ) : null,
        )
      ) : (
        <p class="mt-16 text-center text-muted-foreground">
          {t("team.page.empty")}
        </p>
      )
    }
  </main>
</Layout>
