---
import Layout from "@/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import TeamGroupSection from "@/components/team/TeamGroupSection.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection("team");

// A member can belong to multiple groups; the same person renders once per
// section they're listed in.
const GROUP_ORDER = [
  "direction",
  "editorial",
  "communication",
  "partenariats",
  "billetterie",
  "aidants",
  "inclusivite",
] as const;
const byGroup = Object.fromEntries(
  GROUP_ORDER.map((g) => [g, all.filter((m) => m.data.groups.includes(g))]),
) as Record<(typeof GROUP_ORDER)[number], CollectionEntry<"team">[]>;

const groupTitles = {
  direction: t("team.group.direction"),
  editorial: t("team.group.editorial"),
  communication: t("team.group.communication"),
  partenariats: t("team.group.partenariats"),
  billetterie: t("team.group.billetterie"),
  aidants: t("team.group.aidants"),
  inclusivite: t("team.group.inclusivite"),
} as const;

const hasAnyMember = all.length > 0;
---

<Layout title={t("team.page.title")} lang={lang}>
  <main class="mx-auto max-w-7xl px-4 md:px-6 py-24">
    <header class="text-center">
      <h1 class="text-4xl font-bold text-foreground">{t("team.page.title")}</h1>
      <p class="mt-4 text-base text-muted-foreground max-w-2xl mx-auto">
        {t("team.page.intro")}
      </p>
    </header>

    {
      hasAnyMember ? (
        GROUP_ORDER.map((g) =>
          byGroup[g].length > 0 ? (
            <TeamGroupSection
              group={g}
              members={byGroup[g]}
              lang={lang}
              title={groupTitles[g]}
            />
          ) : null,
        )
      ) : (
        <p class="mt-16 text-center text-muted-foreground">
          {t("team.page.empty")}
        </p>
      )
    }
  </main>
</Layout>
