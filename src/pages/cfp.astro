---
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/utils";
import { FLAGS } from "@/config/flags";
import { getFlagState } from "@/lib/flags";
import { cfpEventUrl, cfpEventLabel } from "@/lib/pretalx";

const lang = "fr";
const t = useTranslations(lang);
const cfpState = getFlagState(FLAGS.cfp);

const CFP_URL = cfpEventUrl();
const CFP_LABEL = cfpEventLabel();

const formats = [
  {
    duration: "10 min",
    title: "Présentation éclair",
    body: "Un format court et synthétique pour aller droit au but. Le temps est votre principal challenge — assurez-vous que votre contenu soit concis et percutant.",
  },
  {
    duration: "30 min",
    title: "Retour d'expérience",
    body: "Idéal pour partager des cas concrets en entreprise, des retours sur des projets open source, ou une expérience personnelle. Q&A incluses.",
  },
  {
    duration: "45 min",
    title: "Conférence",
    body: "Pour approfondir un sujet complexe, entrer dans les détails techniques, avec éventuellement des démonstrations. Q&A incluses.",
  },
];

const parcours = [
  {
    emoji: "🔓",
    title: "Autonomie numérique et Open Source",
    body: "Maîtriser sa dépendance : souveraineté des données, alternatives ouvertes, contribution amont, et le coût réel de la réversibilité.",
  },
  {
    emoji: "🎯",
    title: "DevEx et Platform Engineering",
    body: "Construire une plateforme que les équipes choisissent d'utiliser : golden paths, self-service, et la mesure de ce qui leur fait réellement gagner du temps.",
  },
  {
    emoji: "🤖",
    title: "L'IA à l'épreuve du réel",
    body: "Ce que l'IA change vraiment en production : coûts, latence, données, garde-fous. Des retours d'expérience plutôt que des démos.",
  },
  {
    emoji: "🔭",
    title: "Observabilité et fiabilité",
    body: "Comprendre un système en production : des signaux utiles plutôt que des tableaux de bord, des SLO tenables, et ce qu'on apprend d'un incident.",
  },
  {
    emoji: "🛡️",
    title: "Sécurité et confiance",
    body: "Sécuriser sans bloquer : chaîne d'approvisionnement, secrets, identités et conformité, intégrés au travail des équipes plutôt qu'ajoutés après.",
  },
  {
    emoji: "🧱",
    title: "Fondations: Infrastructure, données, réseau",
    body: "Les couches sur lesquelles tout repose : Kubernetes, stockage, réseau, bases de données — leur exploitation au quotidien et à l'échelle.",
  },
];

const horsPiste = {
  emoji: "🚀",
  title: "Hors pistes, sujets divers",
  body: "Ce qui n'entre nulle part ailleurs et mérite d'être entendu : expérimentations, angles inattendus, et le retour d'expérience qu'on n'ose pas raconter.",
};

const criteria = [
  { key: "Retours d'expérience", body: "concrets sur l'application des technologies Cloud Native." },
  { key: "Open source", body: "moteurs d'innovation et de collaboration." },
  { key: "Innovation et expertise technique", body: "qui repoussent les limites de votre domaine." },
  { key: "Projets francophones et locaux", body: "valorisant notre écosystème." },
  { key: "Contenu inédit", body: "ou rarement présenté lors d'autres conférences." },
  { key: "Diversité", body: "des profils et des approches." },
];
---

<Layout title={cfpState === "active" ? "Appel à conférences (CFP)" : t("cfp.closed_for_now.title")} description="Cloud Native Days France — Call for Papers." lang={lang}>
  <main>
    {cfpState !== "active" && (
      <section class="mx-auto max-w-2xl px-4 md:px-6 pt-24 md:pt-32 pb-24 md:pb-32">
        <h1 class="text-4xl md:text-5xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
          {t("cfp.closed_for_now.title")}
        </h1>
        <p class="mt-6 text-base md:text-lg text-muted-foreground">
          {t("cfp.closed_for_now.body")}
        </p>
      </section>
    )}
    {cfpState === "active" && (
    <>
    <section class="mx-auto max-w-5xl px-4 md:px-6 pt-16 md:pt-24 pb-10 md:pb-12">
      <span class="inline-flex items-center rounded-full bg-accent/15 text-accent px-3 py-1 text-xs font-semibold uppercase tracking-wider">
        CFP 2027 — ouvert
      </span>
      <h1 class="mt-5 text-4xl md:text-6xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
        Proposez une intervention
      </h1>
      <p class="mt-4 text-base md:text-lg text-muted-foreground">
        Une journée. 7 thèmes. 3 formats. Et votre voix.
      </p>
      <a
        href={CFP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-primary text-primary-foreground text-base font-semibold px-6 h-12 transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        Soumettre une proposition <span aria-hidden="true">→</span>
      </a>
      <p class="mt-4 text-sm text-muted-foreground">
        3 juin 2027 · CENTQUATRE-PARIS · au cœur de la communauté francophone du Cloud Native
      </p>
    </section>

    <section class="mx-auto max-w-6xl px-4 md:px-6 py-10 md:py-12">
      <h2 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
        Les 7 thèmes
      </h2>
      <p class="mt-2 text-sm md:text-base text-muted-foreground">
        Choisissez le terrain de votre sujet.
      </p>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {parcours.map((th) => (
          <article class="rounded-lg border border-border bg-card p-4 md:p-5 transition-colors hover:border-primary/60">
            <div class="flex items-center gap-3">
              <div class="inline-flex items-center justify-center w-9 h-9 rounded-full text-lg bg-primary/10 shrink-0" aria-hidden="true">
                {th.emoji}
              </div>
              <h3 class="text-base md:text-lg font-bold text-foreground tracking-tight">
                {th.title}
              </h3>
            </div>
            <p class="mt-2 text-sm md:text-base text-muted-foreground leading-relaxed">
              {th.body}
            </p>
          </article>
        ))}
        <article class="sm:col-span-2 lg:col-span-3 flex flex-wrap items-center gap-4 rounded-lg border border-accent/60 bg-card p-4 md:p-5 transition-colors hover:border-accent">
          <div class="inline-flex items-center justify-center w-9 h-9 rounded-full text-lg bg-accent/15 shrink-0" aria-hidden="true">
            {horsPiste.emoji}
          </div>
          <h3 class="text-base md:text-lg font-bold text-foreground tracking-tight shrink-0">
            {horsPiste.title}
          </h3>
          <p class="flex-1 min-w-0 text-sm md:text-base text-muted-foreground leading-relaxed">
            {horsPiste.body}
          </p>
        </article>
      </div>
    </section>

    <section id="formats" class="mx-auto max-w-6xl px-4 md:px-6 py-10 md:py-12">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12">
        <div>
          <h3 class="text-xl font-bold text-foreground tracking-tight">
            Les formats
          </h3>
          <ul role="list" class="mt-5 space-y-4">
            {formats.map((f) => (
              <li class="flex items-start gap-3">
                <span class="self-start shrink-0 inline-flex items-center rounded-full bg-primary/10 text-primary px-3 py-1 text-xs font-bold">
                  {f.duration}
                </span>
                <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
                  <strong class="font-semibold text-foreground">{f.title}</strong> — {f.body}
                </p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-bold text-foreground tracking-tight">
            À savoir
          </h3>
          <ul role="list" class="mt-5 space-y-4">
            <li class="text-sm md:text-base text-muted-foreground leading-relaxed">
              <span aria-hidden="true">🇫🇷</span> Toutes les présentations se déroulent <strong class="font-semibold text-foreground">en français</strong> — slides en anglais acceptés si cela facilite votre préparation.
            </li>
            <li class="text-sm md:text-base text-muted-foreground leading-relaxed">
              Des <strong class="font-semibold text-foreground">start-ups</strong> aux <strong class="font-semibold text-foreground">grands groupes</strong> : une audience de pairs qui rencontrent les mêmes défis que vous.
            </li>
            <li class="text-sm md:text-base text-muted-foreground leading-relaxed">
              <strong class="font-semibold text-foreground">Nos valeurs</strong> : <span aria-hidden="true">❤️</span> Communauté · <span aria-hidden="true">🌍</span> Inclusion &amp; diversité · <span aria-hidden="true">🌱</span> Écologie · <span aria-hidden="true">🇫🇷</span> Autonomie numérique
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 md:px-6 py-10 md:py-12">
      <h2 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
        Ce que le comité privilégie
      </h2>
      <p class="mt-4 text-base md:text-lg text-muted-foreground leading-relaxed">
        Notre comité de sélection — bénévoles de l'organisation CND France et membres reconnus des communautés cloud native francophones — privilégiera les propositions qui&nbsp;:
      </p>
      <ul role="list" class="mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-4">
        {criteria.map((c) => (
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 mt-0.5 text-primary"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="text-base text-muted-foreground leading-relaxed">
              <span class="font-semibold text-foreground">{c.key}</span> — {c.body}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-8 bg-card border-y border-border">
      <div class="mx-auto max-w-6xl px-4 md:px-6 py-12 md:py-16">
        <h2 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
          Soumettez votre proposition
        </h2>
        <a
          href={CFP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-primary text-primary-foreground text-base md:text-lg font-semibold px-8 h-14 transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          Proposer une intervention <span aria-hidden="true">→</span>
        </a>
        <p class="mt-4 text-xs text-muted-foreground">{CFP_LABEL}</p>
      </div>
    </section>
    </>
    )}
  </main>
</Layout>
