---
import Layout from "../../../layouts/Layout.astro";
import SpeakerAvatar from "@/components/speakers/SpeakerAvatar.astro";
import SocialLinks from "@/components/speakers/SocialLinks.astro";
import { getSpeakersByLocale, getSlug } from "@/lib/speakers";
import { getLangFromUrl, useTranslations, getLocalePath } from "@/i18n/utils";
import { EDITIONS, isEdition, CURRENT_EDITION, type Edition } from "@/lib/editions";
import ComingNotice from "@/components/ComingNotice.astro";

export async function getStaticPaths() {
  return EDITIONS.map((year) => ({ params: { year: String(year) } }));
}

const { year: yearParam } = Astro.params;
const yearNum = Number(yearParam);
if (!isEdition(yearNum)) {
  return Astro.redirect(`/intervenants/${CURRENT_EDITION}`, 308);
}
const year: Edition = yearNum;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const speakers = await getSpeakersByLocale(lang, year);

function positionLabel(role?: string, company?: string): string | undefined {
  if (role && company) return `${role} (${company})`;
  return role || company || undefined;
}

const sortByName = (a: typeof speakers[number], b: typeof speakers[number]) =>
  a.data.name.localeCompare(b.data.name);

const keynoteLeads = speakers.filter((s) => s.data.keynote_size === "lead").sort(sortByName);
const keynoteGuests = speakers.filter((s) => s.data.keynote_size === "guest").sort(sortByName);
const keynotePanel = speakers.filter((s) => s.data.keynote_size === "panel").sort(sortByName);

const keynoteSlugs = new Set(
  [...keynoteLeads, ...keynoteGuests, ...keynotePanel].map((s) => getSlug(s.id)),
);
const hasKeynote = keynoteSlugs.size > 0;
const regular = speakers
  .filter((s) => !keynoteSlugs.has(getSlug(s.id)))
  .sort(sortByName);
---

<Layout title={`${t("speakers.heading")} ${year} | ${t("site.title")}`}>
  <main class="px-4 md:px-6 lg:px-8">
    {year === CURRENT_EDITION && <ComingNotice class="mx-auto max-w-6xl mt-8" />}
    <section class="pt-16 md:pt-24 pb-10 md:pb-14 text-center">
      <h1
        class="text-4xl md:text-5xl font-bold text-foreground tracking-tight"
        style="letter-spacing: -0.02em;"
      >
        {`${t("speakers.heading")} ${year}`}
      </h1>
      <p class="mt-3 text-base md:text-lg text-muted-foreground">
        {t("speakers.subtext")}
      </p>
    </section>

    {speakers.length === 0 && (
      <section class="text-center py-16">
        <h2 class="text-2xl font-bold text-foreground">
          {t("speakers.empty_heading")}
        </h2>
        <p class="mt-2 text-muted-foreground">{t("speakers.empty_body")}</p>
      </section>
    )}

    {hasKeynote && (
      <section class="max-w-7xl mx-auto pb-14 md:pb-20">
        <p class="mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-destructive">
          {t("speakers.keynote_rail_label")}
        </p>

        {keynoteLeads.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-10">
            {keynoteLeads.map((s) => {
              const slug = getSlug(s.id);
              const position = positionLabel(s.data.role, s.data.company);
              const social = {
                linkedin: s.data.linkedin,
                github: s.data.github,
                bluesky: s.data.bluesky,
                website: s.data.website,
              };
              return (
                <article
                  class="group relative flex flex-col items-center text-center gap-3 rounded-2xl border border-border bg-card p-6 transition-colors duration-200 hover:border-primary/50 focus-within:ring-2 focus-within:ring-ring focus-within:ring-offset-2 focus-within:ring-offset-background"
                >
                  <span
                    aria-hidden="true"
                    class="absolute rounded-full ring-2 ring-destructive/80 pointer-events-none"
                    style="top:1.5rem; left:50%; transform:translateX(-50%); width:148px; height:148px;"
                  ></span>
                  <a
                    href={getLocalePath(lang, `/speakers/${year}/${slug}`)}
                    class="flex flex-col items-center gap-3 focus-visible:outline-none"
                  >
                    <div class="relative h-[144px] w-[144px] rounded-full overflow-hidden bg-secondary">
                      <SpeakerAvatar name={s.data.name} photo={s.data.photo_url} size="lg" />
                    </div>
                    {slug === "petazzoni" && (
                      <span class="inline-block px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-destructive bg-background border border-destructive rounded-full">
                        {t("speakers.keynote_badge_mc")}
                      </span>
                    )}
                    <h2 class="text-xl md:text-2xl font-bold text-foreground" style="letter-spacing:-0.02em;">
                      {s.data.name}
                    </h2>
                    {position && (
                      <p class="text-sm text-muted-foreground">{position}</p>
                    )}
                  </a>
                  <SocialLinks social={social} />
                </article>
              );
            })}
          </div>
        )}

        {keynoteGuests.length > 0 && (
          <ul role="list" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5 mb-10">
            {keynoteGuests.map((s) => {
              const slug = getSlug(s.id);
              const position = positionLabel(s.data.role, s.data.company);
              const social = {
                linkedin: s.data.linkedin,
                github: s.data.github,
                bluesky: s.data.bluesky,
                website: s.data.website,
              };
              return (
                <li>
                  <article
                    class="group flex h-full flex-col items-center text-center rounded-lg border border-border bg-card p-5 transition-all duration-200 hover:border-primary/60 motion-safe:hover:-translate-y-0.5 focus-within:ring-2 focus-within:ring-ring"
                  >
                    <a
                      href={getLocalePath(lang, `/speakers/${year}/${slug}`)}
                      class="flex flex-col items-center focus-visible:outline-none"
                    >
                      <div class="h-[120px] w-[120px] rounded-full overflow-hidden bg-secondary">
                        <SpeakerAvatar name={s.data.name} photo={s.data.photo_url} size="lg" />
                      </div>
                      <p class="mt-3 text-base font-bold text-foreground line-clamp-2">{s.data.name}</p>
                      {position && (
                        <p class="mt-1 text-sm text-muted-foreground line-clamp-2">{position}</p>
                      )}
                    </a>
                    <div class="mt-3">
                      <SocialLinks social={social} />
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        )}

        {keynotePanel.length > 0 && (
          <ul role="list" class="grid grid-cols-3 sm:grid-cols-5 gap-3">
            {keynotePanel.map((s) => {
              const slug = getSlug(s.id);
              return (
                <li>
                  <a
                    href={getLocalePath(lang, `/speakers/${year}/${slug}`)}
                    class="group flex flex-col items-center text-center rounded-md border border-border bg-card p-3 transition-colors duration-200 hover:border-primary/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  >
                    <SpeakerAvatar name={s.data.name} photo={s.data.photo_url} size="sm" />
                    <p class="mt-2 text-xs font-semibold text-foreground line-clamp-2">{s.data.name}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    )}

    {regular.length > 0 && (
      <section class="max-w-7xl mx-auto pb-16 md:pb-24">
        <p
          class="mb-4 text-xs font-semibold uppercase tracking-[0.2em]"
          style="color: var(--color-primary, #4985e8);"
        >
          {t("speakers.regular_rail_label")}
        </p>

        <ul
          role="list"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-5"
        >
          {regular.map((speaker) => {
            const slug = getSlug(speaker.id);
            const position = positionLabel(speaker.data.role, speaker.data.company);
            const social = {
              linkedin: speaker.data.linkedin,
              github: speaker.data.github,
              bluesky: speaker.data.bluesky,
              website: speaker.data.website,
            };
            return (
            <li>
              <article
                class="group flex flex-col h-full rounded-lg border border-border bg-card p-5 text-center transition-all duration-200 hover:border-primary/60 motion-safe:hover:-translate-y-0.5 focus-within:ring-2 focus-within:ring-ring focus-within:ring-offset-2 focus-within:ring-offset-background"
              >
                <a
                  href={getLocalePath(lang, `/speakers/${year}/${slug}`)}
                  class="flex flex-col items-center flex-1 focus-visible:outline-none"
                >
                  <SpeakerAvatar
                    name={speaker.data.name}
                    photo={speaker.data.photo_url}
                    size="sm"
                  />
                  <p class="mt-3 text-base font-bold text-foreground">
                    {speaker.data.name}
                  </p>
                  {position && (
                    <p class="mt-1 text-sm text-muted-foreground">{position}</p>
                  )}
                </a>
                <div class="mt-3 flex justify-center">
                  <SocialLinks social={social} />
                </div>
              </article>
            </li>
            );
          })}
        </ul>
      </section>
    )}
  </main>
</Layout>
