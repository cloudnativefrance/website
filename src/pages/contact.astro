---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { useTranslations, getLangFromUrl } from "@/i18n/utils";
import { CONTACT_EMAILS } from "@/lib/event";
import participantPhoto from "@/assets/photos/contact/participant.jpg";
import intervenantPhoto from "@/assets/photos/contact/intervenants.jpg";
import partenairePhoto from "@/assets/photos/contact/partenaire.jpg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const audiences = [
  { email: CONTACT_EMAILS.participants, icon: "ticket",    titleKey: "contact.participants.title", bodyKey: "contact.participants.body", photo: participantPhoto, photoAlt: "Participantes et participants Cloud Native Days France 2026" },
  { email: CONTACT_EMAILS.speakers,     icon: "mic",       titleKey: "contact.speakers.title",     bodyKey: "contact.speakers.body",     photo: intervenantPhoto, photoAlt: "Intervenant(e) sur scène à Cloud Native Days France 2026" },
  { email: CONTACT_EMAILS.sponsors,     icon: "handshake", titleKey: "contact.sponsors.title",     bodyKey: "contact.sponsors.body",     photo: partenairePhoto,  photoAlt: "Stand partenaire à Cloud Native Days France 2026" },
] as const;
---

<Layout
  title={`${t("contact.heading")} | ${t("site.title")}`}
  description={t("contact.lead")}
>
  <main class="mx-auto max-w-6xl px-4 md:px-6 lg:px-8 py-16 md:py-24">
    <section class="text-center max-w-2xl mx-auto">
      <h1
        class="text-4xl md:text-5xl font-bold text-foreground tracking-tight"
        style="letter-spacing:-0.02em"
      >
        {t("contact.heading")}
      </h1>
      <p class="mt-5 text-base md:text-lg text-muted-foreground">
        {t("contact.lead")}
      </p>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-3">
      {audiences.map(({ email, icon, titleKey, bodyKey, photo, photoAlt }) => (
        <article class="rounded-lg border border-border bg-card p-6 md:p-7 flex flex-col gap-5 overflow-hidden">
          <span
            aria-hidden="true"
            class="inline-flex w-16 h-16 items-center justify-center rounded-2xl bg-primary text-primary-foreground shadow-md"
          >
            {icon === "ticket" && (
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
                <path d="M13 5v2M13 17v2M13 11v2"/>
              </svg>
            )}
            {icon === "mic" && (
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                <line x1="12" x2="12" y1="19" y2="22"/>
              </svg>
            )}
            {icon === "handshake" && (
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="m11 17 2 2a1 1 0 1 0 3-3"/>
                <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/>
                <path d="m21 3 1 11h-2M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3M3 4h8"/>
              </svg>
            )}
          </span>
          <div class="flex-1">
            <h2 class="text-2xl font-semibold text-foreground">{t(titleKey)}</h2>
            <p class="mt-2 text-base text-muted-foreground">{t(bodyKey)}</p>
          </div>
          <div class="flex items-center gap-2 self-start flex-wrap">
            <a
              href={`mailto:${email}`}
              class="inline-flex items-center gap-2 rounded-full bg-muted px-4 py-2 text-sm font-medium text-foreground hover:bg-muted/70 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            >
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              {email}
            </a>
            <button
              type="button"
              class="copy-email inline-flex items-center justify-center w-8 h-8 rounded-full bg-muted hover:bg-muted/70 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              data-email={email}
              aria-label={`Copier l'adresse ${email}`}
              title="Copier l'adresse e-mail"
            >
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
            </button>
          </div>
          <Picture
            src={photo}
            alt={photoAlt}
            widths={[400, 600, 800, 1200]}
            sizes="(min-width: 768px) 33vw, 100vw"
            formats={["avif", "webp"]}
            loading="lazy"
            decoding="async"
            class="w-full aspect-[4/3] object-cover rounded-md"
          />
        </article>
      ))}
    </section>

    <section class="mt-16 text-center">
      <p class="text-base md:text-lg text-muted-foreground">{t("contact.community.helper")}</p>
      <SocialLinks class="mt-4 justify-center" />
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-email").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const email = btn.dataset.email || "";
      try {
        await navigator.clipboard.writeText(email);
        const svg = btn.querySelector("svg");
        if (svg) {
          svg.innerHTML = '<polyline points="20 6 9 17 4 12"/>';
        }
        setTimeout(() => {
          if (svg) {
            svg.innerHTML = '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>';
          }
        }, 1500);
      } catch {}
    });
  });
</script>
