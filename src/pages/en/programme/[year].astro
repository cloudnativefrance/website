---
import Layout from "../../../layouts/Layout.astro";
import ScheduleGrid from "@/components/schedule/ScheduleGrid.astro";
import ScheduleParcours from "@/components/schedule/ScheduleParcours.astro";
import { loadSessions, getProgrammeMetadata } from "@/lib/schedule";
import { getSpeakersByLocale, getSlug } from "@/lib/speakers";
import { loadEventTracks } from "@/lib/tracks";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import ComingSoonLayout from "@/components/flags/ComingSoonLayout.astro";
import { isEditionLoadable } from "@/lib/edition-visibility";
import { EDITIONS, isEdition, CURRENT_EDITION, type Edition } from "@/lib/editions";
import ComingNotice from "@/components/ComingNotice.astro";

export async function getStaticPaths() {
  return EDITIONS.map((year) => ({ params: { year: String(year) } }));
}

const { year: yearParam } = Astro.params;
const yearNum = Number(yearParam);
if (!isEdition(yearNum)) {
  return Astro.redirect(`/en/programme/${CURRENT_EDITION}`, 308);
}
const year: Edition = yearNum;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// One rule for "may this edition be fetched" and "may this page be shown", so
// the two cannot disagree. See src/lib/edition-visibility.ts.
const programmeReady = isEditionLoadable(year);

const sessions = programmeReady ? await loadSessions(year) : [];
const speakerEntries = programmeReady ? await getSpeakersByLocale(lang, year) : [];
// The parcours strip is presentational; an empty list simply omits it.
const eventTracks = programmeReady ? await loadEventTracks(year) : [];

const speakerInfo = new Map<string, { name: string; company?: string }>();
for (const s of speakerEntries) {
  const info = { name: s.data.name, company: s.data.company };
  speakerInfo.set(getSlug(s.id), info);
  speakerInfo.set(s.data.name, info);
}

const { railLabel, subtitle, programmePdfUrl, programmePdfLabel } =
  getProgrammeMetadata(year, lang);

---

{programmeReady ? (
<Layout title={`${t("schedule.heading")} ${year} | ${t("site.title")}`}>
    <main
      class="px-4 md:px-6 lg:px-8"
      data-schedule-active-singular={t("schedule.filter.active_singular")}
      data-schedule-active-plural={t("schedule.filter.active_plural")}
    >
      {sessions.length === 0 ? (
        <section class="max-w-3xl mx-auto pt-16 md:pt-24 pb-20 text-center">
          <p
            class="text-xs font-semibold uppercase tracking-[0.2em]"
            style="color: var(--color-primary, #4985e8);"
          >
            {railLabel}
          </p>
          <h1 class="mt-3 text-4xl md:text-5xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
            {`${t("schedule.heading")} ${year}`}
          </h1>
          <p class="mt-6 text-base md:text-lg text-muted-foreground">
            {t("schedule.empty_state")}
          </p>
        </section>
      ) : (
        <>
          <section class="schedule-section max-w-7xl mx-auto pt-16 md:pt-20 pb-6">
            {year === CURRENT_EDITION && <ComingNotice class="mx-auto max-w-6xl mb-8" />}
            <p
              class="text-xs font-semibold uppercase tracking-[0.2em]"
              style="color: var(--color-primary, #4985e8);"
            >
              {railLabel}
            </p>
            {/* Title and subtitle on the left, parcours on the right, bottom
                aligned so the two blocks share a baseline instead of the strip
                floating beside a three-line paragraph. Stacks below lg: seven
                labels and a 5xl heading do not share 1024px. */}
            <div class="mt-3 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
              <div class="min-w-0">
                <h1 class="text-4xl md:text-5xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
                  {`${t("schedule.heading")} ${year}`}
                </h1>
                <p class="mt-3 text-base md:text-lg text-muted-foreground max-w-2xl">
                  {subtitle}
                </p>
              </div>
              <ScheduleParcours tracks={eventTracks} lang={lang} />
            </div>
            {programmePdfUrl && (
              <a
                href={programmePdfUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center justify-center gap-2 h-11 px-5 rounded-md bg-primary text-primary-foreground text-base font-semibold hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              >
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                {programmePdfLabel}
              </a>
            )}
          </section>
          <section class="schedule-section max-w-7xl mx-auto pb-20">
            <ScheduleGrid sessions={sessions} lang={lang} speakerInfo={speakerInfo} year={year} />
          </section>
        </>
      )}
    </main>
</Layout>
) : (
  <ComingSoonLayout flag="programme" lang={lang} />
)}
