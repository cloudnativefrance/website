---
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/utils";

const lang = "en";
const t = useTranslations(lang);
---

<Layout title={t("nav.tickets")} description={t("tickets.coming_soon.title")} lang={lang}>
  <main class="mx-auto max-w-3xl px-4 md:px-6 py-24 md:py-32 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
      {t("tickets.coming_soon.title")}
    </h1>
  </main>
</Layout>
