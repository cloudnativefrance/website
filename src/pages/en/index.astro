---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "@/components/hero/HeroSection.astro";
import KeyNumbers from "@/components/hero/KeyNumbers";
import Edition2026Combined from "@/components/past-editions/Edition2026Combined.astro";
import NewsletterCallout from "@/components/newsletter/NewsletterCallout.astro";
import SponsorsPlatinumStrip from "@/components/sponsors/SponsorsPlatinumStrip.astro";
import { getSponsors } from "@/lib/sponsor-utils";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { eventSchemaJson } from "@/lib/event-schema";
import { isFlagActive } from "@/lib/flags";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const description = t("seo.default_description");
// `site` is always set in astro.config.mjs, and Astro rejects an invalid
// value at config load, so this is defined for every build.
const siteUrl = Astro.site!.toString();
const schemaJson = eventSchemaJson({ lang, siteUrl, description });

const allSponsors = isFlagActive("homepage_sponsors") ? await getSponsors() : [];
const platinumSponsors = allSponsors.filter((s) => s.data.tier === "platinum");
---

<!-- The homepage pitches the newsletter twice, by design (approved 2026-10):
     the mid-page callout below stays where the pitch lands, and the site-wide
     band renders above the footer — where readers look for the signup. Every
     other route carries only the band. -->
<Layout
  title={t("site.title")}
  description={description}
  ogType="event"
>
  <script type="application/ld+json" set:html={schemaJson} />
  <main>
    <HeroSection />
    <KeyNumbers client:idle lang={lang} />
    <NewsletterCallout lang={lang} />
    <Edition2026Combined />
    {platinumSponsors.length > 0 && (
      <SponsorsPlatinumStrip
        id="sponsors-homepage"
        sponsors={platinumSponsors}
        lang={lang}
      />
    )}
  </main>
</Layout>
