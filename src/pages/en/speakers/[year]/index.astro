---
import Layout from "../../../../layouts/Layout.astro";
import SpeakerAvatar from "@/components/speakers/SpeakerAvatar.astro";
import { getSpeakersByLocale, getSlug, getPrimaryTalk } from "@/lib/speakers";
import { loadSessions, type SessionRow } from "@/lib/schedule";
import { getLangFromUrl, useTranslations, getLocalePath } from "@/i18n/utils";
import { EDITIONS, isEdition, CURRENT_EDITION, type Edition } from "@/lib/editions";
import ComingNotice from "@/components/ComingNotice.astro";
import ComingSoonLayout from "@/components/flags/ComingSoonLayout.astro";
import { isEditionLoadable } from "@/lib/edition-visibility";

export async function getStaticPaths() {
  return EDITIONS.map((year) => ({ params: { year: String(year) } }));
}

const { year: yearParam } = Astro.params;
const yearNum = Number(yearParam);
if (!isEdition(yearNum)) {
  return Astro.redirect(`/en/speakers/${CURRENT_EDITION}`, 308);
}
const year: Edition = yearNum;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const speakersReady = isEditionLoadable(year);
const speakers = speakersReady ? await getSpeakersByLocale(lang, year) : [];
const sessions: SessionRow[] = speakersReady ? await loadSessions(year) : [];
const primaryTalkBySlug = new Map<string, SessionRow>();
for (const speaker of speakers) {
  const primary = getPrimaryTalk(getSlug(speaker.id), sessions);
  if (primary) primaryTalkBySlug.set(getSlug(speaker.id), primary);
}

const sortByName = (a: typeof speakers[number], b: typeof speakers[number]) =>
  a.data.name.localeCompare(b.data.name);

const keynoteLeads = speakers.filter((s) => s.data.keynote_size === "lead").sort(sortByName);
const keynoteGuests = speakers.filter((s) => s.data.keynote_size === "guest").sort(sortByName);
const keynotePanel = speakers.filter((s) => s.data.keynote_size === "panel").sort(sortByName);

const keynoteSlugs = new Set(
  [...keynoteLeads, ...keynoteGuests, ...keynotePanel].map((s) => getSlug(s.id)),
);
const hasKeynote = keynoteSlugs.size > 0;
const regular = speakers
  .filter((s) => !keynoteSlugs.has(getSlug(s.id)))
  .sort(sortByName);
---

{speakersReady ? (
<Layout title={`${t("speakers.heading")} ${year} | ${t("site.title")}`}>
  <main class="px-4 md:px-6 lg:px-8">
    {year === CURRENT_EDITION && <ComingNotice class="mx-auto max-w-6xl mt-8" i18nKey="speakers.notice.2027_coming" />}
    <section class="pt-16 md:pt-24 pb-10 md:pb-14 text-center">
      <h1
        class="text-4xl md:text-5xl font-bold text-foreground tracking-tight"
        style="letter-spacing: -0.02em;"
      >
        {`${t("speakers.heading")} ${year}`}
      </h1>
      <p class="mt-3 text-base md:text-lg text-muted-foreground">
        {t("speakers.subtext")}
      </p>
    </section>

    {speakers.length === 0 && (
      <section class="text-center py-16">
        <h2 class="text-2xl font-bold text-foreground">
          {t("speakers.empty_heading")}
        </h2>
        <p class="mt-2 text-muted-foreground">{t("speakers.empty_body")}</p>
      </section>
    )}

    {hasKeynote && (
      <section class="max-w-7xl mx-auto pb-14 md:pb-20">
        <p class="mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-accent">
          {t("speakers.keynote_rail_label")}
        </p>

        {keynoteLeads.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-10">
            {keynoteLeads.map((s) => {
              const slug = getSlug(s.id);
              const primary = primaryTalkBySlug.get(slug);
              return (
                <a
                  href={getLocalePath(lang, `/speakers/${year}/${slug}`)}
                  class="group relative flex flex-col items-center text-center gap-3 rounded-2xl border border-border bg-card p-6 transition-colors duration-200 hover:border-primary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                >
                  <span
                    aria-hidden="true"
                    class="absolute rounded-full ring-2 ring-accent/70 pointer-events-none"
                    style="top:1.5rem; left:50%; transform:translateX(-50%); width:148px; height:148px;"
                  ></span>
                  <div class="relative h-[144px] w-[144px] rounded-full overflow-hidden bg-secondary">
                    <SpeakerAvatar name={s.data.name} photo={s.data.photo_url} fallback={s.data.photo_fallback} size="lg" />
                  </div>
                  <span class="inline-block px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-accent bg-accent/15 rounded-full">
                    {slug === "petazzoni" ? t("speakers.keynote_badge_mc") : t("speakers.keynote_badge")}
                  </span>
                  <h2 class="text-xl md:text-2xl font-bold text-foreground" style="letter-spacing:-0.02em;">
                    {s.data.name}
                  </h2>
                  {(s.data.role || s.data.company) && (
                    <p class="text-sm text-muted-foreground">
                      {[s.data.role, s.data.company].filter(Boolean).join(" — ")}
                    </p>
                  )}
                  {primary && (
                    <p class="mt-1 text-base text-foreground italic">"{primary.title}"</p>
                  )}
                </a>
              );
            })}
          </div>
        )}

        {keynoteGuests.length > 0 && (
          <ul role="list" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5 mb-10">
            {keynoteGuests.map((s) => {
              const slug = getSlug(s.id);
              return (
                <li>
                  <a
                    href={getLocalePath(lang, `/speakers/${year}/${slug}`)}
                    class="group flex h-full flex-col items-center text-center rounded-lg border border-border bg-card p-5 transition-[border-color,translate,box-shadow] duration-200 hover:border-primary/60 motion-safe:hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  >
                    <div class="h-[120px] w-[120px] rounded-full overflow-hidden bg-secondary">
                      <SpeakerAvatar name={s.data.name} photo={s.data.photo_url} fallback={s.data.photo_fallback} size="lg" />
                    </div>
                    <p class="mt-3 text-base font-bold text-foreground line-clamp-2">{s.data.name}</p>
                    {(s.data.role || s.data.company) && (
                      <p class="mt-1 text-sm text-muted-foreground line-clamp-2">
                        {[s.data.role, s.data.company].filter(Boolean).join(" — ")}
                      </p>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        )}

        {keynotePanel.length > 0 && (
          <ul role="list" class="grid grid-cols-3 sm:grid-cols-5 gap-3">
            {keynotePanel.map((s) => {
              const slug = getSlug(s.id);
              return (
                <li>
                  <a
                    href={getLocalePath(lang, `/speakers/${year}/${slug}`)}
                    class="group flex flex-col items-center text-center rounded-md border border-border bg-card p-3 transition-colors duration-200 hover:border-primary/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  >
                    <SpeakerAvatar name={s.data.name} photo={s.data.photo_url} fallback={s.data.photo_fallback} size="sm" />
                    <p class="mt-2 text-xs font-semibold text-foreground line-clamp-2">{s.data.name}</p>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    )}

    {regular.length > 0 && (
      <section class="max-w-7xl mx-auto pb-16 md:pb-24">
        <p
          class="mb-4 text-xs font-semibold uppercase tracking-[0.2em]"
          style="color: var(--color-primary, #4985e8);"
        >
          {t("speakers.regular_rail_label")}
        </p>

        <ul
          role="list"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-5"
        >
          {regular.map((speaker) => {
            const slug = getSlug(speaker.id);
            const primary = primaryTalkBySlug.get(slug);
            return (
            <li>
              <a
                href={getLocalePath(lang, `/speakers/${year}/${slug}`)}
                class="group block h-full rounded-lg border border-border bg-card p-5 text-center transition-[border-color,translate,box-shadow] duration-200 hover:border-primary/60 motion-safe:hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
              >
                <div class="flex flex-col items-center">
                  <SpeakerAvatar
                    name={speaker.data.name}
                    photo={speaker.data.photo_url}
      fallback={speaker.data.photo_fallback}
                    size="sm"
                  />
                  <p class="mt-3 text-base font-bold text-foreground">
                    {speaker.data.name}
                  </p>
                  {(speaker.data.role || speaker.data.company) && (
                    <p class="mt-1 text-sm text-muted-foreground">
                      {[speaker.data.role, speaker.data.company]
                        .filter(Boolean)
                        .join(" — ")}
                    </p>
                  )}
                  {primary && (
                    <p class="mt-2 text-[13px] text-muted-foreground line-clamp-2">
                      {primary.title}
                    </p>
                  )}
                </div>
              </a>
            </li>
            );
          })}
        </ul>
      </section>
    )}
  </main>
</Layout>
) : (
  <ComingSoonLayout flag="programme" lang={lang} />
)}
