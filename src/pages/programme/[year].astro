---
import ComingSoonLayout from "@/components/flags/ComingSoonLayout.astro";
import ProgrammeView from "@/components/schedule/ProgrammeView.astro";
import { loadSessions } from "@/lib/schedule";
import { getSpeakersByLocale } from "@/lib/speakers";
import { loadEventTracks } from "@/lib/tracks";
import { getLangFromUrl } from "@/i18n/utils";
import { isEditionLoadable } from "@/lib/edition-visibility";
import { EDITIONS, isEdition, CURRENT_EDITION, type Edition } from "@/lib/editions";
import { programmePhase } from "@/lib/programme-phase";

export async function getStaticPaths() {
  return EDITIONS.map((year) => ({ params: { year: String(year) } }));
}

const { year: yearParam } = Astro.params;
const yearNum = Number(yearParam);
if (!isEdition(yearNum)) {
  return Astro.redirect(`/programme/${CURRENT_EDITION}`, 308);
}
const year: Edition = yearNum;

const lang = getLangFromUrl(Astro.url);
const phase = programmePhase(year);

// One rule for "may this edition be fetched" and "may this page be shown", so
// the two cannot disagree. See src/lib/edition-visibility.ts. Before its
// programme is announced an edition loads nothing either: its page is the
// "being built" one (src/lib/programme-phase.ts).
const programmeReady = isEditionLoadable(year) && phase === "announced";

const sessions = programmeReady ? await loadSessions(year) : [];
const speakerEntries = programmeReady ? await getSpeakersByLocale(lang, year) : [];
// The parcours strip is presentational; an empty list simply omits it.
const eventTracks = programmeReady ? await loadEventTracks(year) : [];
---

{programmeReady || phase !== "announced" ? (
  <ProgrammeView
    lang={lang}
    year={year}
    phase={phase}
    sessions={sessions}
    speakerEntries={speakerEntries}
    eventTracks={eventTracks}
  />
) : (
  <ComingSoonLayout flag="programme" lang={lang} />
)}
