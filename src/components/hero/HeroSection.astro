---
import GeoBackground from "@/components/patterns/GeoBackground.astro";
import CountdownTimer from "./CountdownTimer";
import FeatureGate from "@/components/flags/FeatureGate.astro";
import { getLangFromUrl, useTranslations, getLocalePath } from "@/i18n/utils";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import logoFullDark from "@/assets/logos/dark/logo.svg";
import logoFullLight from "@/assets/logos/principal/logo.svg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const TICKETS_HREF = getLocalePath(lang, "/tickets");
const SCHEDULE_URL: string | null = getLocalePath(lang, "/programme");
const DISCOVER_URL = getLocalePath(lang, lang === "en" ? "/discover" : "/decouvrir");

// Both logo variants share intrinsic dimensions, so one ratio drives both <img> tags.
const LOGO_HEIGHT = Math.round((400 * logoFullDark.height) / logoFullDark.width);
---

<section
  class="relative flex flex-col items-center justify-center overflow-hidden px-4 pt-4 pb-16 lg:pt-6 lg:pb-24 text-center"
>
  <GeoBackground class="absolute inset-0" />

  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--color-background)_0%,_var(--color-secondary)_100%)] opacity-40 pointer-events-none"
  />

  <div class="relative z-10 mx-auto flex w-full max-w-4xl flex-col items-center gap-8 md:gap-10">
    <h1 class="sr-only">{t("hero.title")}</h1>
    <img
      src={logoFullLight.src}
      alt={t("hero.logo_alt")}
      width={400}
      height={LOGO_HEIGHT}
      class="dark:hidden w-full max-w-[260px] sm:max-w-[320px] md:max-w-[400px] h-auto"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <img
      src={logoFullDark.src}
      alt={t("hero.logo_alt")}
      width={400}
      height={LOGO_HEIGHT}
      class="hidden dark:block w-full max-w-[260px] sm:max-w-[320px] md:max-w-[400px] h-auto"
      loading="lazy"
      decoding="async"
    />

    <div class="flex flex-col items-center gap-2">
      <p
        class="text-2xl sm:text-3xl md:text-4xl font-bold uppercase text-destructive"
        style="letter-spacing: 0.05em;"
      >
        {t("hero.subtitle")}
      </p>
      <p class="text-sm sm:text-base font-medium uppercase text-muted-foreground" style="letter-spacing: 0.05em;">
        {t("hero.venue")}
      </p>
      <p class="text-sm sm:text-base font-bold text-primary" style="letter-spacing: 0.05em;">
        {t("social.hashtag")}
      </p>
    </div>

    <p class="max-w-[720px] text-balance text-lg md:text-xl text-foreground" style="line-height:1.55;">
      {t("hero.description")}
    </p>

    <FeatureGate flag="homepage_countdown">
      <CountdownTimer client:idle lang={lang} />
    </FeatureGate>

    <div class="flex flex-col gap-3 sm:flex-row sm:gap-4 md:gap-6">
      <a
        href={TICKETS_HREF}
        class={cn(
          buttonVariants({ variant: "default", size: "lg" }),
          "h-[52px] px-8 text-xl font-bold shadow-[var(--shadow-glow-primary)] hover:translate-y-[-1px] transition-all duration-150"
        )}
      >
        {t("hero.cta.register")}
      </a>
      <a
        href={DISCOVER_URL}
        class={cn(
          buttonVariants({ variant: "outline", size: "lg" }),
          "h-[52px] px-8 text-lg font-bold",
          "border-2"
        )}
      >
        {t("hero.cta.discover")}
      </a>
      {SCHEDULE_URL && (
        <a
          href={SCHEDULE_URL}
          class={cn(
            buttonVariants({ variant: "outline", size: "lg" }),
            "h-[52px] px-8 text-lg font-bold",
            "border-2 border-primary-strong text-primary-strong bg-transparent",
            "hover:bg-primary/10 hover:text-primary-strong hover:border-primary-strong hover:shadow-[0_0_0_4px_oklch(62.5%_0.162_259.9_/_0.15)]",
            "focus-visible:ring-primary/50"
          )}
        >
          {t("hero.cta.schedule")}
        </a>
      )}
    </div>
  </div>
</section>
