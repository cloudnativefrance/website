---
/**
 * The band across the top of a ticketing card, like the colour band of a
 * badge: CND Deep Purple (`--chart-5`) under the hex mesh for the Stratégie &
 * Leadership ticket, a faint ink tint for the others, so every card title sits
 * in the same place. Both keep a bottom border, so both have one height.
 */
interface Props {
  tone?: "neutral" | "brand";
}

const { tone = "neutral" } = Astro.props;
---

<div
  class:list={[
    "relative isolate flex flex-wrap items-center justify-between gap-x-4 gap-y-2 overflow-hidden rounded-t-[calc(var(--radius-xl)-1px)] border-b px-5 py-4 sm:px-8 sm:py-5",
    tone === "brand"
      ? "bg-chart-5 border-transparent text-white dark:bg-[oklch(40%_0.16_284)]"
      : "border-border bg-foreground/[3.5%] text-foreground",
  ]}
>
  {
    tone === "brand" && (
      <svg
        class="absolute inset-0 -z-10 size-full [mask-image:radial-gradient(70%_120%_at_100%_0%,black_0%,transparent_75%)] text-white/16"
        aria-hidden="true"
      >
        <pattern
          id="card-band-hex"
          width="60"
          height="104"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M30 0 L60 17.3 L60 52 L30 69.3 L0 52 L0 17.3 Z M30 69.3 L30 104"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
          />
          <circle cx="30" cy="0" r="1.6" fill="currentColor" />
          <circle cx="60" cy="52" r="1.6" fill="currentColor" />
          <circle cx="0" cy="52" r="1.6" fill="currentColor" />
        </pattern>
        <rect width="100%" height="100%" fill="url(#card-band-hex)" />
      </svg>
    )
  }
  <slot />
</div>
