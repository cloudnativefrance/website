---
/**
 * The standard ticket — the dominant card, and the only elevated one. Its
 * name is the heading (27/09/2026: no door title above it), then the price of
 * the moment at monumental scale, what ends it right beside it — the pink pill
 * by the tier, the date under the price — the purchase action, and the
 * season's timeline underneath. No rule between price and timeline: they are
 * one ticket, and the card's edge is what separates it from the next one.
 */
import type { TierDefinition } from "@/config/tickets";
import type { TierUrgency, TierWithState } from "@/lib/tickets/phase";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { fill, formatDayMonth, priceParts } from "@/lib/tickets/format";
import Icon from "./Icon.astro";
import TierLadder from "./TierLadder.astro";

interface Props {
  lang: Locale;
  /** The standard ticket's public name. */
  ticketName: string;
  tier: TierDefinition;
  ladder: TierWithState[];
  urgency: TierUrgency;
}

const { lang, ticketName, tier, ladder, urgency } = Astro.props;
const t = useTranslations(lang);
const price = priceParts(tier.price, lang);
// One pink pill, by the tier: "Dernières places" on the last tier, "Stock
// limité" on a tier that can sell out before its date. Never a quota, never a count.
const pill = urgency.lastTier
  ? t("tickets.offer.last_seats")
  : urgency.limitedStock
    ? t("tickets.ladder.limited_stock")
    : undefined;
const deadline = urgency.endsAt
  ? fill(
      t(
        urgency.limitedStock
          ? "tickets.ladder.until_or_sold_out"
          : "tickets.ladder.until",
      ),
      {
        date: formatDayMonth(urgency.endsAt, lang),
      },
    )
  : undefined;
---

<article
  id="offre"
  class="door border-primary/35 bg-card relative flex grow flex-col gap-8 rounded-xl border p-5 shadow-[0_1px_2px_oklch(15.5%_0.04_268/0.05),0_12px_32px_-12px_oklch(15.5%_0.04_268/0.18)] sm:p-8 dark:shadow-[0_0_0_1px_oklch(62.5%_0.162_259.9/0.25),var(--shadow-glow-primary)]"
  aria-labelledby="door-offer-title"
  style="--door-index: 0"
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,26rem)_auto] lg:gap-10">
    <div class="flex flex-col gap-3">
      <div class="flex flex-col gap-1.5">
        <h2
          id="door-offer-title"
          class="text-foreground text-2xl font-semibold tracking-[-0.01em]"
          data-ticket-name="standard"
        >
          {fill(t("tickets.offer.ticket"), { name: ticketName })}
        </h2>
        <p
          class="text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-2 text-base font-semibold"
        >
          <span>{tier.name[lang]}</span>
          {
            pill && (
              <span
                class="bg-accent text-accent-foreground inline-flex items-center rounded-full px-2.5 py-1 text-xs leading-none font-bold tracking-[0.06em] uppercase"
                data-offer-pill
              >
                {pill}
              </span>
            )
          }
        </p>
      </div>
      <p
        class="text-foreground flex items-baseline gap-3"
        data-offer-price={tier.price}
      >
        <span
          class="text-[clamp(3.5rem,11vw,5.5rem)] leading-none font-bold tracking-[-0.035em] tabular-nums"
        >
          {
            price.before && (
              <span class="mr-1 align-top text-[0.45em] font-semibold tracking-normal">
                {price.before}
              </span>
            )
          }
          {price.amount}
          {
            price.after && (
              <span class="ml-1.5 text-[0.45em] font-semibold tracking-normal">
                {price.after}
              </span>
            )
          }
        </span>
        <span class="text-muted-foreground text-base font-medium"
          >{t("tickets.offer.ttc")}</span
        >
      </p>
      {
        /* The price's own caption: the day it ends, where the eye already is.
          None on the last tier, which runs to the event day. */
      }
      {
        deadline && (
          <p
            class="text-foreground flex items-center gap-2 text-base font-semibold text-pretty"
            data-offer-deadline
          >
            <Icon name="clock" size={18} class="shrink-0" />
            <span>{deadline}</span>
          </p>
        )
      }
    </div>

    {
      /* The action column — the mobile bar watches it (tickets-ui.ts) and takes
        over once it and the Stratégie & Leadership ticket's have both left the screen. */
    }
    <div class="flex flex-col justify-center gap-4" data-offer-action>
      <slot name="purchase" />
    </div>
  </div>

  {
    /* `mt-auto`: when "Venir en équipe" beside it is the taller card, the slack
      lands between the offer and the timeline rather than around the price. */
  }
  <div class="mt-auto">
    <TierLadder items={ladder} lang={lang} />
  </div>
</article>
