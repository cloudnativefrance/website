---
/**
 * The "coming soon" page /billetterie serves until the ticketing opens — the
 * `pre_opening` phase. Just the announcement: the layout's newsletter block
 * underneath is the only action, and no price or tier is shown before the day.
 */
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<main class="mx-auto max-w-3xl px-4 md:px-6 py-24 md:py-32 text-center" data-tickets-coming-soon>
  <span class="inline-flex items-center gap-2 rounded-full bg-accent/15 text-accent px-3 py-1 text-xs font-semibold uppercase tracking-wider">
    <span aria-hidden="true">🎟️</span>
    {t("tickets.opening.badge")}
  </span>
  <h1 class="mt-5 text-4xl md:text-5xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
    {t("tickets.opening.title")} <span class="text-primary whitespace-nowrap">{t("tickets.opening.date")}</span>
  </h1>
  <p class="mt-6 text-base md:text-lg text-muted-foreground">
    {t("tickets.opening.body")}
  </p>
</main>
