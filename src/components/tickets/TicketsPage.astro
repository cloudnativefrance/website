---
/**
 * What /billetterie, /en/tickets and the demo routes mount: the "coming soon"
 * page before the opening, then the ticketing page for the tier on sale.
 */
import Layout from "@/layouts/Layout.astro";
import type { Phase } from "@/config/tickets";
import { useTranslations } from "@/i18n/utils";
import type { Locale } from "@/i18n/ui";
import { ticketDemosEnabled } from "@/lib/tickets/demo";
import TicketsContent from "./TicketsContent.astro";
import TicketsComingSoon from "./TicketsComingSoon.astro";
import DemoBar from "./DemoBar.astro";

interface Props {
  lang: Locale;
  phase: Phase;
  /** A demo route's phase rather than the config's own: never indexed. */
  simulated?: boolean;
}

const { lang, phase, simulated = false } = Astro.props;
const t = useTranslations(lang);
const switcher = ticketDemosEnabled();
const comingSoon = phase === "pre_opening";
---

<Layout
  title={comingSoon ? t("nav.tickets") : t("tickets.meta.title")}
  description={comingSoon
    ? t("tickets.opening.body")
    : t("tickets.meta.description")}
  lang={lang}
  newsletter={comingSoon}
  noindex={simulated}
>
  {switcher && <DemoBar lang={lang} phase={phase} simulated={simulated} />}
  {
    phase === "pre_opening" ? (
      <TicketsComingSoon lang={lang} />
    ) : (
      <TicketsContent lang={lang} phase={phase} demo={switcher} />
    )
  }
</Layout>

{!comingSoon && <script>import "./tickets-ui.ts";</script>}
