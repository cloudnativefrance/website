---
/**
 * The ticketing page's icons: one outline set (lucide geometry), one stroke per
 * size, coloured by `currentColor` so states come from CSS, never from assets.
 * Decorative by default — the text beside an icon carries its meaning.
 */
const PATHS = {
  minus: ["M5 12h14"],
  plus: ["M5 12h14", "M12 5v14"],
  "arrow-right": ["M5 12h14", "m12 5 7 7-7 7"],
  "chevron-right": ["m9 18 6-6-6-6"],
  check: ["M20 6 9 17l-5-5"],
  mail: ["M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7", "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"],
  external: ["M15 3h6v6", "M10 14 21 3", "M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"],
  ban: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "m4.9 4.9 14.2 14.2"],
  clock: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "M12 6v6l4 2"],
  pencil: [
    "M12 20h9",
    "M16.38 3.62a1 1 0 0 1 3 3L7.37 18.64a2 2 0 0 1-.86.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.86z",
  ],
  moon: ["M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"],
  bell: ["M10.27 21a2 2 0 0 0 3.46 0", "M3.26 15.33A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.67C19.41 13.96 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.41 5.96-2.74 7.33"],
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  /** Rendered size in px. */
  size?: number;
  /** 1.5 beside regular text, 2 beside semibold/bold. */
  stroke?: 1.5 | 2;
  class?: string;
}

const { name, size = 16, stroke = 2, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={["shrink-0", className]}
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
