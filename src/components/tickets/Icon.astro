---
/**
 * The ticketing page's icons: one outline set (lucide geometry), one stroke per
 * size, coloured by `currentColor` so states come from CSS, never from assets.
 * Decorative by default — the text beside an icon carries its meaning.
 */
const PATHS = {
  plus: ["M5 12h14", "M12 5v14"],
  "arrow-right": ["M5 12h14", "m12 5 7 7-7 7"],
  /** Leaves the site, in a new tab: every hand-off to alf.io. */
  "arrow-up-right": ["M7 7h10v10", "M7 17 17 7"],
  "chevron-right": ["m9 18 6-6-6-6"],
  check: ["M20 6 9 17l-5-5"],
  mail: [
    "M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7",
    "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z",
  ],
  ban: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "m4.9 4.9 14.2 14.2"],
  clock: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "M12 6v6l4 2"],
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  /** Rendered size in px. */
  size?: number;
  /** 1.5 beside regular text, 2 beside semibold/bold. */
  stroke?: 1.5 | 2;
  class?: string;
}

const { name, size = 16, stroke = 2, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={["shrink-0", className]}
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
