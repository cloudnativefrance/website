---
/**
 * The ticketing page's content, composed around the ways people arrive — the
 * standard ticket, as a team, the Stratégie & Leadership ticket, with a code —
 * weighted by importance.
 * `TicketsPage` wraps it in the layout; kept apart so the demo matrix test can
 * render every phase without a site origin.
 *
 * Rendered for a selling phase only — before the opening /billetterie is the
 * "coming soon" page (`TicketsPage`). Everything is derived from
 * `src/config/tickets.ts` and the tier on sale, so the demo routes and
 * /billetterie render the same page. Every purchase — both tickets of door 1,
 * the mobile bar — goes to the alf.io listing through one `purchaseTarget`.
 */
import GeoBackground from "@/components/patterns/GeoBackground.astro";
import { TICKETING, type TierId } from "@/config/tickets";
import { useTranslations } from "@/i18n/utils";
import type { Locale } from "@/i18n/ui";
import { CONTACT_EMAILS, TARGET_DATE } from "@/lib/event";
import { buildMailto } from "@/lib/tickets/mailto";
import {
  fill,
  formatFullDate,
  formatPercent,
  formatPrice,
  upperFirst,
} from "@/lib/tickets/format";
import {
  cheaperGroupRates,
  offerTier,
  tierStates,
  tierUrgency,
} from "@/lib/tickets/phase";
import {
  codeFallbackAction,
  listingUrl,
  purchaseTarget,
} from "@/lib/tickets/purchase";
import OfferDoor from "./OfferDoor.astro";
import TeamDoor from "./TeamDoor.astro";
import CodeDoor from "./CodeDoor.astro";
import PurchaseControl from "./PurchaseControl.astro";
import StrategicOffer from "./StrategicOffer.astro";
import IncludedInTicket from "./IncludedInTicket.astro";
import TicketsFaq from "./TicketsFaq.astro";
import StickyTicketBar from "./StickyTicketBar.astro";

interface Props {
  lang: Locale;
  /** The tier on sale. */
  phase: TierId;
  /** With the demo on, the mobile bar is striped so no capture passes for the real page. */
  demo?: boolean;
}

const { lang, phase, demo } = Astro.props;
const t = useTranslations(lang);
const config = TICKETING;

const tier = offerTier(config, phase);
const ladder = tierStates(config, phase);
const urgency = tierUrgency(config, tier);
const rates = cheaperGroupRates(config, tier);
const email = CONTACT_EMAILS.tickets;

const groupMailto = buildMailto(
  email,
  t("tickets.team.mail.subject"),
  t("tickets.team.mail.body"),
);

// One action for the whole page, the alf.io listing: both tickets of door 1 and
// the mobile bar share it.
const target = purchaseTarget(config);

// Two tickets: the standard one the tiers price, and the Strategy & Leadership
// one at a single price.
const standardName = config.standardName[lang];
const strategic = {
  name: config.strategic.name[lang],
  price: config.strategic.price,
  trackUrl: config.strategic.trackUrl[lang],
};

// The FAQ answers that end on the ticketing address, each with its own
// pre-filled mail. A body's {standard} and {strategic} are the tickets' names.
const ticketNames = { standard: standardName, strategic: strategic.name };
const faqMailto = {
  wire: buildMailto(
    email,
    t("tickets.wire.mail.subject"),
    fill(t("tickets.wire.mail.body"), ticketNames),
  ),
  perOrder: buildMailto(
    email,
    t("tickets.per_order.mail.subject"),
    fill(t("tickets.per_order.mail.body"), ticketNames),
  ),
  invoice: buildMailto(
    email,
    t("tickets.invoice.mail.subject"),
    t("tickets.invoice.mail.body"),
  ),
  inclusion: buildMailto(
    email,
    t("tickets.inclusion.mail.subject"),
    t("tickets.inclusion.mail.body"),
  ),
};

// Door 2 is rendered only when a group rate actually beats the price of the
// moment and fits the tier's order cap; below that it had nothing to sell.
// Everything else about the first viewport follows from it.
const showTeam = rates.length > 0;

const eventDate = formatFullDate(TARGET_DATE, lang);
// Split around {venue} so the venue can be set unbreakable: "CENTQUATRE-PARIS"
// must never break at its hyphen on a narrow screen.
const [whenBefore, whenAfter = ""] = t("tickets.when").split("{venue}");
const when = {
  before: fill(whenBefore, {
    date: upperFirst(eventDate),
  }),
  venue: t("hero.venue"),
  after: whenAfter,
};

// "standard" is lower-case in prose; the bar's label opens on it.
const sticky = {
  label: `${upperFirst(standardName)} · ${tier.name[lang]}`,
  price: formatPrice(tier.price, lang),
  action: { href: target.href, rel: target.rel, text: t("tickets.sticky.buy") },
  analytics: {
    "data-umami-event-billet": "standard",
    "data-umami-event-palier": tier.id,
    "data-umami-event-phase": phase,
  },
};

const early = config.tiers
  .filter((x) => x.closesWhenSoldOut)
  .map((x) => x.maxPerOrder);
const later = config.tiers
  .filter((x) => !x.closesWhenSoldOut)
  .map((x) => x.maxPerOrder);
const perOrder = { early: Math.max(...early), later: Math.max(...later) };
---

<main class="tickets-page" data-phase={phase}>
  <section class="relative isolate overflow-hidden">
    <GeoBackground class="tickets-mesh absolute inset-0 -z-10" />
    <div
      class="mx-auto flex max-w-7xl flex-col gap-8 px-4 pt-8 pb-16 md:px-6 md:pt-12 md:pb-20 lg:px-8"
    >
      <header class="flex max-w-4xl flex-col gap-3">
        <h1
          class="text-foreground text-4xl leading-[1.05] font-bold tracking-[-0.025em] text-balance sm:text-5xl"
        >
          {t("tickets.h1")}
        </h1>
        <p class="text-foreground text-lg font-semibold text-pretty sm:text-xl">
          {when.before}<span class="whitespace-nowrap">{when.venue}</span>{
            when.after
          }
        </p>
      </header>

      {
        /* Three rows, one per way in (27/09/2026). The standard ticket leads;
          "Venir en équipe" — its group rates, the same ticket bought several
          at a time — sits beside it at the same height whenever a rate
          applies, and it takes the whole row otherwise. The Stratégie &
          Leadership ticket is its own row underneath, the code entry a band at the foot, in
          every phase. */
      }
      <div class="grid gap-5 lg:grid-cols-12 lg:gap-6">
        {
          /* `flex flex-col` so each card fills the row height the grid gives
            its wrapper: the two cards of the first row end on the same line. */
        }
        <div
          class:list={[
            "flex flex-col",
            showTeam ? "lg:col-span-8" : "lg:col-span-12",
          ]}
        >
          <OfferDoor
            lang={lang}
            ticketName={standardName}
            tier={tier}
            ladder={ladder}
            urgency={urgency}
          >
            <PurchaseControl
              slot="purchase"
              target={target}
              lang={lang}
              phase={phase}
              analytics={{ billet: "standard", palier: tier.id }}
            />
          </OfferDoor>
        </div>
        {
          showTeam && (
            <div class="flex flex-col lg:col-span-4">
              <TeamDoor
                lang={lang}
                ticketName={standardName}
                tier={tier}
                rates={rates}
                groupMailto={groupMailto}
              />
            </div>
          )
        }
        {/* Always displayed, always on sale: the same action. */}
        <div class="lg:col-span-12" style={`--door-index: ${showTeam ? 2 : 1}`}>
          <StrategicOffer
            lang={lang}
            name={strategic.name}
            standardName={standardName}
            price={strategic.price}
            trackUrl={strategic.trackUrl}
          >
            <PurchaseControl
              slot="purchase"
              target={target}
              lang={lang}
              phase={phase}
              analytics={{ billet: "strategique", palier: "strategique" }}
            />
          </StrategicOffer>
        </div>
        <div class="lg:col-span-12" style={`--door-index: ${showTeam ? 3 : 2}`}>
          <CodeDoor
            lang={lang}
            phase={phase}
            listingUrl={listingUrl(config)}
            fallback={codeFallbackAction(config)}
          />
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 pb-20 md:px-6 md:pb-24 lg:px-8">
    <IncludedInTicket lang={lang} />
  </div>

  <div class="mx-auto max-w-7xl px-4 pb-28 md:px-6 md:pb-24 lg:px-8">
    <TicketsFaq
      lang={lang}
      email={email}
      mailto={faqMailto}
      perOrder={perOrder}
      strategicName={strategic.name}
      programmeWhen={config.programmeAnnouncement[lang]}
      vatRate={formatPercent(config.vatRate, lang)}
    />
  </div>
</main>

<StickyTicketBar
  lang={lang}
  label={sticky.label}
  price={sticky.price}
  action={sticky.action}
  analytics={sticky.analytics}
  demo={Boolean(demo)}
/>

<style>
  .tickets-page :global(::selection) {
    background: color-mix(in oklab, var(--color-primary) 28%, transparent);
    color: var(--color-foreground);
  }
  .tickets-page :global(.tickets-mesh) {
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 35%,
      transparent 85%
    );
    opacity: 0.9;
  }

  /* One authored entrance: the three doors settle in sequence, once, from an
     already-visible default (reduced motion keeps them still, global.css). */
  @media (prefers-reduced-motion: no-preference) {
    .tickets-page :global(.door) {
      animation: door-in 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--door-index, 0) * 90ms + 60ms);
    }
  }
  @keyframes door-in {
    from {
      opacity: 0;
      translate: 0 14px;
      filter: blur(3px);
    }
  }
</style>
