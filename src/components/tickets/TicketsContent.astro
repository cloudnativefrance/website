---
/**
 * The ticketing page for the tier on sale: the standard ticket, with "Venir en
 * équipe" beside it when a group rate applies, the Stratégie & Leadership
 * ticket, the code band, then what the ticket includes and the FAQ. Kept apart
 * from `TicketsPage` so the tests can render it without a layout.
 */
import GeoBackground from "@/components/patterns/GeoBackground.astro";
import { TICKETING, type TierId } from "@/config/tickets";
import { useTranslations } from "@/i18n/utils";
import type { Locale } from "@/i18n/ui";
import { TARGET_DATE } from "@/lib/event";
import { fill, formatFullDate, upperFirst } from "@/lib/tickets/format";
import { cheaperGroupRates, offerTier, tierStates } from "@/lib/tickets/phase";
import OfferDoor from "./OfferDoor.astro";
import TeamDoor from "./TeamDoor.astro";
import CodeDoor from "./CodeDoor.astro";
import PurchaseControl from "./PurchaseControl.astro";
import StrategicOffer from "./StrategicOffer.astro";
import IncludedInTicket from "./IncludedInTicket.astro";
import TicketsFaq from "./TicketsFaq.astro";
import StickyTicketBar from "./StickyTicketBar.astro";

interface Props {
  lang: Locale;
  phase: TierId;
  /** Stripes the mobile bar, so no capture of the demo passes for the real page. */
  demo?: boolean;
}

const { lang, phase, demo = false } = Astro.props;
const t = useTranslations(lang);

const tier = offerTier(TICKETING, phase);
const rates = cheaperGroupRates(TICKETING, tier);
const showTeam = rates.length > 0;

// Split around {venue} to keep "CENTQUATRE-PARIS" from breaking at its hyphen.
const [beforeVenue, afterVenue] = fill(t("tickets.when"), {
  date: upperFirst(formatFullDate(TARGET_DATE, lang)),
}).split("{venue}");

const umami = (billet: "standard" | "strategique", palier: string) => ({
  "data-umami-event-billet": billet,
  "data-umami-event-palier": palier,
  "data-umami-event-phase": phase,
});
---

<main class="tickets-page">
  <section class="relative isolate overflow-hidden">
    <GeoBackground class="tickets-mesh absolute inset-0 -z-10" />
    <div
      class="mx-auto flex max-w-7xl flex-col gap-8 px-4 pt-8 pb-16 md:px-6 md:pt-12 md:pb-20 lg:px-8"
    >
      <header class="flex max-w-4xl flex-col gap-3">
        <h1
          class="text-foreground text-4xl leading-[1.05] font-bold tracking-[-0.025em] text-balance sm:text-5xl"
        >
          {t("tickets.h1")}
        </h1>
        <p class="text-foreground text-lg font-semibold text-pretty sm:text-xl">
          {beforeVenue}<span class="whitespace-nowrap">{t("hero.venue")}</span>{
            afterVenue
          }
        </p>
      </header>

      {
        /* Each wrapper is a flex column so the card inside fills its grid row. */
      }
      <div class="grid gap-5 lg:grid-cols-12 lg:gap-6">
        <div
          class:list={[
            "flex flex-col",
            showTeam ? "lg:col-span-8" : "lg:col-span-12",
          ]}
        >
          <OfferDoor
            lang={lang}
            tier={tier}
            ladder={tierStates(TICKETING, phase)}
          >
            <PurchaseControl
              slot="purchase"
              lang={lang}
              analytics={umami("standard", phase)}
            />
          </OfferDoor>
        </div>
        {
          showTeam && (
            <div class="flex flex-col lg:col-span-4" style="--door-index: 1">
              <TeamDoor lang={lang} tier={tier} rates={rates} />
            </div>
          )
        }
        <div class="lg:col-span-12" style={`--door-index: ${showTeam ? 2 : 1}`}>
          <StrategicOffer lang={lang}>
            <PurchaseControl
              slot="purchase"
              lang={lang}
              analytics={umami("strategique", "strategique")}
            />
          </StrategicOffer>
        </div>
        <div class="lg:col-span-12" style={`--door-index: ${showTeam ? 3 : 2}`}>
          <CodeDoor lang={lang} phase={phase} />
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 pb-20 md:px-6 md:pb-24 lg:px-8">
    <IncludedInTicket lang={lang} />
  </div>

  <div class="mx-auto max-w-7xl px-4 pb-28 md:px-6 md:pb-24 lg:px-8">
    <TicketsFaq lang={lang} />
  </div>
</main>

<StickyTicketBar
  lang={lang}
  tier={tier}
  analytics={umami("standard", phase)}
  demo={demo}
/>

<style>
  .tickets-page :global(::selection) {
    background: color-mix(in oklab, var(--color-primary) 28%, transparent);
    color: var(--color-foreground);
  }
  .tickets-page :global(.tickets-mesh) {
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 35%,
      transparent 85%
    );
    opacity: 0.9;
  }

  /* The cards settle in sequence, once (global.css stills them under reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    .tickets-page :global(.door) {
      animation: door-in 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--door-index, 0) * 90ms + 60ms);
    }
  }
  @keyframes door-in {
    from {
      opacity: 0;
      translate: 0 14px;
      filter: blur(3px);
    }
  }
</style>
