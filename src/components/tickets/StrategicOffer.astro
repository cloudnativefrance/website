---
/**
 * The Stratégie & Leadership ticket, drawn like the standard one but without
 * the lift shadow, and set apart by its band: CND Deep Purple, with the
 * "Nouveauté 2027" pill. One price for the season: no tier, no date, no
 * ladder. Above it, "Tarif de lancement" while `launchPrice` holds, where the
 * standard card names its tier; under it, its fixed number of seats, set in
 * the band's purple: the card's urgency, ahead of the copy. Then who it is for
 * and what it adds, as three checks; the track's page says the rest.
 */
import { TICKETING } from "@/config/tickets";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { fill } from "@/lib/tickets/format";
import BigPrice from "./BigPrice.astro";
import CardBand from "./CardBand.astro";
import Icon from "./Icon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { name, price, launchPrice, seats, trackUrl, lounge } =
  TICKETING.strategic;
const perks = [
  t("tickets.strategic.perks.event"),
  t("tickets.strategic.perks.track"),
  fill(t("tickets.strategic.perks.lounge"), { lounge: lounge[lang] }),
];
---

<article
  id="strategie-leadership"
  class="door border-chart-5 bg-card flex flex-col rounded-xl border dark:border-[oklch(45%_0.16_284)]"
  aria-labelledby="strategic-title"
>
  <CardBand tone="brand">
    <h2 id="strategic-title" class="text-2xl font-semibold tracking-[-0.01em]">
      {fill(t("tickets.offer.ticket"), { name: name[lang] })}
    </h2>
    <span
      class="bg-accent text-accent-foreground inline-flex items-center rounded-full px-2.5 py-1 text-xs leading-none font-bold tracking-[0.06em] whitespace-nowrap uppercase"
    >
      {t("tickets.strategic.new")}
    </span>
  </CardBand>

  <div
    class="grid gap-6 p-5 sm:p-8 lg:grid-cols-[minmax(0,36rem)_1fr] lg:gap-10"
  >
    <div class="flex flex-col gap-3">
      {
        launchPrice && (
          <p class="text-foreground text-base font-semibold">
            {t("strategy.ticket.launch")}
          </p>
        )
      }
      <BigPrice amount={price} lang={lang} />
      {
        /* A filled Deep Purple pill, the track page's white hero pill turned
           over: not pink, which the band's "Nouveauté 2027" already holds. */
      }
      <p
        class="bg-chart-5 inline-flex items-center gap-2 self-start rounded-full px-4 py-2 text-base font-bold text-white dark:bg-[oklch(40%_0.16_284)]"
      >
        <Icon name="users" size={18} />
        <span>{fill(t("tickets.strategic.seats"), { count: seats })}</span>
      </p>
      <div class="flex max-w-[52ch] flex-col gap-2.5 pt-1 text-base">
        <p class="text-muted-foreground text-pretty">
          {t("tickets.strategic.audience")}
        </p>
        <ul class="flex flex-col gap-2">
          {
            perks.map((perk) => (
              <li class="text-foreground flex items-start gap-2.5 font-medium text-pretty">
                <Icon
                  name="check"
                  size={18}
                  class="text-primary-strong mt-0.5"
                />
                {perk}
              </li>
            ))
          }
        </ul>
      </div>
      {
        /* Inline, not flex: when the line wraps, the arrow follows the last word. */
      }
      <p class="text-base font-semibold text-pretty">
        <a
          href={trackUrl[lang]}
          class="text-primary-strong underline-offset-4 hover:underline"
          data-umami-event="tickets-strategic-track"
        >
          {t("tickets.strategic.track")}<Icon
            name="arrow-right"
            size={16}
            class="ml-1.5 inline-block align-[-0.125em]"
          /></a
        >
      </p>
    </div>

    {/* The button ends the card, like the standard ticket's above. */}
    <div
      class="flex flex-col items-start justify-center lg:items-end"
      data-offer-action
    >
      <slot name="purchase" />
    </div>
  </div>
</article>
