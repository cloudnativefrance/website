---
/**
 * The Stratégie & Leadership ticket, drawn like the standard one but without
 * the lift shadow, and set apart by its band: CND Deep Purple, with a
 * neutral "Nouveauté 2027" pill beside the title. One price for the season:
 * no tier, no date, no ladder. Above it, where the standard card names its tier, "Tarif de
 * lancement" while `launchPrice` holds and its fixed number of seats in the
 * pink pill the standard card gives "Places limitées". Then who it is for and
 * what it adds, as three checks; the track's page says the rest.
 */
import { TICKETING } from "@/config/tickets";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { fill } from "@/lib/tickets/format";
import BigPrice from "./BigPrice.astro";
import CardBand from "./CardBand.astro";
import Icon from "./Icon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { name, price, launchPrice, seats, trackUrl, room, lounge } =
  TICKETING.strategic;
const perks = [
  t("tickets.strategic.perks.event"),
  fill(t("tickets.strategic.perks.track"), { room }),
  fill(t("tickets.strategic.perks.lounge"), { lounge: lounge[lang] }),
];
---

<article
  id="strategie-leadership"
  class="door border-chart-5 bg-card flex flex-col rounded-xl border dark:border-[oklch(45%_0.16_284)]"
  aria-labelledby="strategic-title"
>
  <CardBand tone="brand">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <h2
        id="strategic-title"
        class="text-2xl font-semibold tracking-[-0.01em]"
      >
        {fill(t("tickets.offer.ticket"), { name: name[lang] })}
      </h2>
      {/* Neutral, like the evening's: pink is kept for the seats below. */}
      <span
        class="border-border bg-card text-foreground inline-flex items-center rounded-full border px-2.5 py-1 text-xs leading-none font-bold tracking-[0.06em] whitespace-nowrap uppercase"
      >
        {t("tickets.strategic.new")}
      </span>
    </div>
  </CardBand>

  <div
    class="grid gap-6 p-5 sm:p-8 lg:grid-cols-[minmax(0,36rem)_1fr] lg:gap-10"
  >
    <div class="flex flex-col gap-3">
      {
        /* Drawn like the standard card's tier line and its "Places limitées"
           pill, so the two tickets say scarcity the same way. */
      }
      <p
        class="text-foreground flex flex-wrap items-center gap-x-3 gap-y-2 text-base font-semibold"
      >
        {launchPrice && <span>{t("strategy.ticket.launch")}</span>}
        <span
          class="bg-accent text-accent-foreground inline-flex items-center rounded-full px-2.5 py-1 text-xs leading-none font-bold tracking-[0.06em] uppercase"
        >
          {fill(t("tickets.strategic.seats"), { count: seats })}
        </span>
      </p>
      <BigPrice amount={price} lang={lang} />
      <div class="flex max-w-[52ch] flex-col gap-2.5 pt-1 text-base">
        <p class="text-muted-foreground text-pretty">
          {t("tickets.strategic.audience")}
        </p>
        <ul class="flex flex-col gap-2">
          {
            perks.map((perk) => (
              <li class="text-foreground flex items-start gap-2.5 font-medium text-pretty">
                <Icon
                  name="check"
                  size={18}
                  class="text-primary-strong mt-0.5"
                />
                {perk}
              </li>
            ))
          }
        </ul>
      </div>
      {
        /* Inline, not flex: when the line wraps, the arrow follows the last word. */
      }
      <p class="text-base font-semibold text-pretty">
        <a
          href={trackUrl[lang]}
          class="text-primary-strong underline-offset-4 hover:underline"
          data-umami-event="tickets-strategic-track"
        >
          {t("tickets.strategic.track")}<Icon
            name="arrow-right"
            size={16}
            class="ml-1.5 inline-block align-[-0.125em]"
          /></a
        >
      </p>
    </div>

    {/* The button ends the card, like the standard ticket's above. */}
    <div
      class="flex flex-col items-start justify-center lg:items-end"
      data-offer-action
    >
      <slot name="purchase" />
    </div>
  </div>
</article>
