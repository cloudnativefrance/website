---
/**
 * The Stratégie & Leadership ticket, in its own card under the standard one
 * (27/09/2026). The track of the same name is open to every ticket; this one
 * adds priority access to its room and a reserved networking area — which is
 * all it says, with a link to the track's own page for the rest.
 *
 * The standard card's anatomy and type — name, monumental price, one line, the
 * same filled button in a column that lines up with the standard one. Only the
 * standard card's shadow sets the two apart. One price for the whole season,
 * so no tier, no date, no pill, no timeline. Always on sale, with the page's
 * own action in the `purchase` slot; its quota is never shown.
 */
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { fill, priceParts } from "@/lib/tickets/format";
import Icon from "./Icon.astro";

interface Props {
  lang: Locale;
  name: string;
  /** The standard ticket's name, which this one includes. */
  standardName: string;
  /** Euros, VAT included; undefined while undecided — the price line is then left out. */
  price?: number;
  /** The track's page, once it exists. */
  trackUrl?: string;
}

const { lang, name, standardName, price, trackUrl } = Astro.props;
const t = useTranslations(lang);
const parts = price === undefined ? undefined : priceParts(price, lang);
---

<article
  id="strategie-leadership"
  class="door border-primary/35 bg-card grid gap-6 rounded-xl border p-5 sm:p-8 lg:grid-cols-[minmax(0,26rem)_auto] lg:gap-10"
  aria-labelledby="strategic-title"
  data-strategic-ticket
>
  <div class="flex flex-col gap-3">
    <h2
      id="strategic-title"
      class="text-foreground text-2xl font-semibold tracking-[-0.01em]"
      data-ticket-name="strategic"
    >
      {fill(t("tickets.offer.ticket"), { name })}
    </h2>
    {
      parts && (
        <p
          class="text-foreground flex items-baseline gap-3"
          data-strategic-price={price}
        >
          <span class="text-[clamp(3.5rem,11vw,5.5rem)] leading-none font-bold tracking-[-0.035em] tabular-nums">
            {parts.before && (
              <span class="mr-1 align-top text-[0.45em] font-semibold tracking-normal">
                {parts.before}
              </span>
            )}
            {parts.amount}
            {parts.after && (
              <span class="ml-1.5 text-[0.45em] font-semibold tracking-normal">
                {parts.after}
              </span>
            )}
          </span>
          <span class="text-muted-foreground text-base font-medium">
            {t("tickets.offer.ttc")}
          </span>
        </p>
      )
    }
    <p class="text-muted-foreground max-w-[52ch] text-base text-pretty">
      {fill(t("tickets.strategic.perks"), { standard: standardName })}
    </p>
    {
      /* Inline, not flex: when the line wraps, the arrow follows the last word
        instead of standing apart at the far edge. */
    }
    {
      trackUrl && (
        <p class="text-base font-semibold text-pretty">
          <a
            href={trackUrl}
            class="text-primary-strong underline-offset-4 hover:underline"
            data-umami-event="tickets-strategic-track"
          >
            {t("tickets.strategic.track")}
            <Icon
              name="arrow-right"
              size={16}
              class="ml-1.5 inline-block align-[-0.125em]"
            />
          </a>
        </p>
      )
    }
  </div>

  {
    /* An action column like the standard card's: the mobile bar stays away
      while it is on screen, so it never sits under a button for the other ticket. */
  }
  <div class="flex flex-col justify-center gap-4" data-offer-action>
    <slot name="purchase" />
  </div>
</article>
