---
/**
 * What the standard ticket includes. A plain checklist, not a grid of feature
 * cards: one column, kept narrow so the lines stay readable inside the page's
 * wide container. The last line teases what is not announced yet — the evening
 * had its own card here until the organisers froze its details; restore it
 * from git history (tickets.included.evening.*) once they are settled.
 */
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = [
  t("tickets.included.talks"),
  t("tickets.included.village"),
  t("tickets.included.meals"),
  t("tickets.included.goodies"),
  t("tickets.included.surprises"),
];
---

<section class="flex max-w-3xl flex-col gap-6" aria-labelledby="included-title">
  <h2
    id="included-title"
    class="text-foreground text-3xl font-bold tracking-[-0.02em] text-balance sm:text-4xl"
  >
    {t("tickets.included.title")}
  </h2>
  <ul class="flex flex-col gap-3">
    {
      items.map((item) => (
        <li class="text-foreground flex items-start gap-3 text-lg">
          <span class="bg-primary/10 text-primary-strong mt-1 grid size-6 shrink-0 place-items-center rounded-full">
            <Icon name="check" size={14} />
          </span>
          <span class="text-pretty">{item}</span>
        </li>
      ))
    }
  </ul>
</section>
