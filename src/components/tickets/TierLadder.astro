---
/**
 * The season's four prices as a timeline, read in one sweep and without a
 * legend: four boxes chained by chevrons, the tier on offer drawn as a
 * selected card, the ones behind it struck through and "Épuisé", the ones
 * ahead held back — outlined, muted, clearly not open yet.
 *
 * Part of the standard ticket's card, under its price (27/09/2026): compact,
 * one height for every box, and no date or pill of its own — both sit a few
 * lines up, beside the big price, in the same card. No box shows a date: the
 * team may extend or re-quota a tier live.
 */
import type { TierId } from "@/config/tickets";
import type { TierWithState } from "@/lib/tickets/phase";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { formatPrice } from "@/lib/tickets/format";
import Icon from "./Icon.astro";

interface Props {
  items: TierWithState[];
  lang: Locale;
}

const { items, lang } = Astro.props;
const t = useTranslations(lang);

type Tone = "past" | "selected" | "upcoming";

/** The tier on sale is drawn as selected — the same tier the card prices in full. */
function toneOf(item: TierWithState): Tone {
  if (item.state.kind === "past") return "past";
  if (item.state.kind === "current") return "selected";
  return "upcoming";
}

// Three surfaces, not three hues. The selected tier is the only filled box:
// tinted, thick-edged, lifted. Past is a ghost. Upcoming is an empty outline —
// present, priced, but visibly not open.
const toneClass: Record<Tone, string> = {
  past: "border-dashed border-input/60 bg-muted/40 text-muted-foreground",
  selected:
    "border-2 border-primary-strong bg-primary/6 text-foreground ring-4 ring-primary/15 shadow-[0_8px_20px_-14px_oklch(48%_0.18_259.9/0.5)]",
  upcoming: "border-border bg-transparent text-muted-foreground",
};

const tierIds: TierId[] = items.map((i) => i.tier.id);
---

<div class="flex flex-col gap-3" data-tier-ladder={tierIds.join(" ")}>
  <h3 class="text-sm font-semibold text-muted-foreground">{t("tickets.ladder.title")}</h3>

  <ol class="grid grid-cols-1 gap-5 sm:grid-cols-4 sm:gap-7">
    {items.map((item, index) => {
      const tone = toneOf(item);
      const isPast = tone === "past";
      const isLast = index === items.length - 1;
      return (
        <li
          class:list={[
            "relative flex items-center justify-between gap-3 rounded-lg border px-4 py-2.5 sm:flex-col sm:items-start sm:justify-center sm:gap-0.5 sm:px-3.5",
            toneClass[tone],
          ]}
          aria-current={item.state.kind === "current" ? "step" : undefined}
          data-tier={item.tier.id}
          data-tier-state={item.state.kind}
        >
          <span class:list={["text-sm font-semibold", tone === "selected" && "text-primary-strong"]}>
            {item.tier.name[lang]}
            {/* The state word the box does not need: kept for screen readers,
                where shape and colour carry nothing. */}
            {tone === "selected" && (
              <span class="sr-only">
                {" · "}{t("tickets.ladder.current")}
              </span>
            )}
          </span>
          <span class="flex flex-wrap items-baseline justify-end gap-x-2 gap-y-0.5 sm:justify-start">
            <span
              class:list={[
                "text-lg font-bold tabular-nums tracking-[-0.02em]",
                isPast && "line-through decoration-muted-foreground/50 decoration-[1.5px]",
              ]}
            >
              {formatPrice(item.tier.price, lang)}
            </span>
            {isPast && (
              <span class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.05em] text-muted-foreground">
                <Icon name="ban" size={12} />
                {t("tickets.ladder.sold_out")}
              </span>
            )}
          </span>

          {/* The climb, drawn: down the stack on mobile, along the row from sm.
              Sits in the gutter, outside the box, and says nothing to a reader.
              Every box has the same height, so the chevron sits at mid-height. */}
          {!isLast && (
            <span
              aria-hidden="true"
              class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 translate-y-0.5 text-muted-foreground/60 sm:left-full sm:top-1/2 sm:-translate-y-1/2 sm:translate-x-1.5"
            >
              <Icon name="chevron-right" size={16} class="rotate-90 sm:rotate-0" />
            </span>
          )}
        </li>
      );
    })}
  </ol>
</div>
