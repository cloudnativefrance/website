---
/**
 * The season's four prices as a progress bar: filled up to the tier on sale,
 * its segments interlocking like chevrons, each pointing to the next tier. The
 * tiers behind are struck through and "Épuisé", the ones ahead greyed. No tier
 * shows a date: the team may extend or re-quota a tier live.
 */
import type { TierState, TierWithState } from "@/lib/tickets/phase";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { formatPrice } from "@/lib/tickets/format";
import Icon from "./Icon.astro";

interface Props {
  items: TierWithState[];
  lang: Locale;
}

const { items, lang } = Astro.props;
const t = useTranslations(lang);

// Information, not options (08/10/2026): no box, no ring, which read as
// tiles to pick. The fill runs from the season's start to the tier on sale.
const segmentClass: Record<TierState, string> = {
  past: "bg-primary/30",
  current: "bg-primary",
  upcoming: "bg-border",
};
---

<div class="flex flex-col gap-3">
  <h3 class="text-muted-foreground text-sm font-semibold">
    {t("tickets.ladder.title")}
  </h3>

  {
    /* Mobile: one row per tier, the bar down the left, the prices in one
       column (rows are subgrids). From sm: one column per tier under its
       segment of a horizontal bar. */
  }
  <ol
    class="grid grid-cols-[auto_1fr_auto_auto] gap-x-3 gap-y-1 sm:grid-cols-4 sm:gap-x-1 sm:gap-y-0"
  >
    {
      items.map(({ tier, state }) => (
        <li
          class:list={[
            "col-span-4 grid grid-cols-subgrid items-baseline sm:col-span-1 sm:flex sm:flex-col sm:items-start sm:pr-3",
            state === "current" ? "text-foreground" : "text-muted-foreground",
          ]}
          aria-current={state === "current" ? "step" : undefined}
          data-tier={tier.id}
        >
          {/* Runs into the li's padding from sm, so the segments sit 4px apart. */}
          <span
            aria-hidden="true"
            class:list={[
              "segment w-2.5 self-stretch sm:-mr-3 sm:mb-3 sm:h-2.5 sm:w-auto",
              segmentClass[state],
            ]}
          />
          <span
            class:list={[
              "py-2.5 text-sm font-semibold sm:py-0",
              state === "current" && "text-primary-strong",
            ]}
          >
            {tier.name[lang]}
            {state === "current" && (
              <span class="sr-only">
                {" · "}
                {t("tickets.ladder.current")}
              </span>
            )}
          </span>
          <span class="contents sm:flex sm:flex-wrap sm:items-baseline sm:gap-x-2 sm:gap-y-0.5">
            <span
              class:list={[
                "justify-self-end text-lg font-bold tracking-[-0.02em] tabular-nums",
                state === "past" &&
                  "decoration-muted-foreground/50 line-through decoration-[1.5px]",
              ]}
            >
              {formatPrice(tier.price, lang)}
            </span>
            {state === "past" && (
              <span class="text-muted-foreground inline-flex items-center gap-1 text-xs font-semibold tracking-[0.05em] uppercase">
                <Icon name="ban" size={12} />
                {t("tickets.ladder.sold_out")}
              </span>
            )}
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* Each segment ends in a point that nests into the next one's notch: the
     chevrons of the old ladder, now the bar's own joints. Down on mobile,
     along the row from sm; the outer ends are rounded. */
  .segment {
    --tip: 5px;
    clip-path: polygon(
      0 0,
      50% var(--tip),
      100% 0,
      100% calc(100% - var(--tip)),
      50% 100%,
      0 calc(100% - var(--tip))
    );
  }
  li:first-child .segment {
    border-radius: 999px 999px 0 0;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--tip)),
      50% 100%,
      0 calc(100% - var(--tip))
    );
  }
  li:last-child .segment {
    border-radius: 0 0 999px 999px;
    clip-path: polygon(0 0, 50% var(--tip), 100% 0, 100% 100%, 0 100%);
  }
  @media (min-width: 40rem) {
    .segment {
      clip-path: polygon(
        0 0,
        calc(100% - var(--tip)) 0,
        100% 50%,
        calc(100% - var(--tip)) 100%,
        0 100%,
        var(--tip) 50%
      );
    }
    li:first-child .segment {
      border-radius: 999px 0 0 999px;
      clip-path: polygon(
        0 0,
        calc(100% - var(--tip)) 0,
        100% 50%,
        calc(100% - var(--tip)) 100%,
        0 100%
      );
    }
    li:last-child .segment {
      border-radius: 0 999px 999px 0;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, var(--tip) 50%);
    }
  }
</style>
