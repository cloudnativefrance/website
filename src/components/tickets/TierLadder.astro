---
/**
 * The season's four prices as a timeline: the tier on sale drawn as the one
 * selected box, the ones behind it struck through and "Épuisé", the ones ahead
 * outlined. No box shows a date: the team may extend or re-quota a tier live.
 */
import type { TierState, TierWithState } from "@/lib/tickets/phase";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { formatPrice } from "@/lib/tickets/format";
import Icon from "./Icon.astro";

interface Props {
  items: TierWithState[];
  lang: Locale;
}

const { items, lang } = Astro.props;
const t = useTranslations(lang);

const stateClass: Record<TierState, string> = {
  past: "border-dashed border-input/60 bg-muted/40 text-muted-foreground",
  current:
    "border-2 border-primary-strong bg-primary/6 text-foreground ring-4 ring-primary/15 shadow-[0_8px_20px_-14px_oklch(48%_0.18_259.9/0.5)]",
  upcoming: "border-border bg-transparent text-muted-foreground",
};
---

<div class="flex flex-col gap-3">
  <h3 class="text-muted-foreground text-sm font-semibold">
    {t("tickets.ladder.title")}
  </h3>

  <ol class="grid grid-cols-1 gap-5 sm:grid-cols-4 sm:gap-7">
    {
      items.map(({ tier, state }, index) => (
        <li
          class:list={[
            "relative flex items-center justify-between gap-3 rounded-lg border px-4 py-2.5 sm:flex-col sm:items-start sm:justify-center sm:gap-0.5 sm:px-3.5",
            stateClass[state],
          ]}
          aria-current={state === "current" ? "step" : undefined}
          data-tier={tier.id}
        >
          <span
            class:list={[
              "text-sm font-semibold",
              state === "current" && "text-primary-strong",
            ]}
          >
            {tier.name[lang]}
            {state === "current" && (
              <span class="sr-only">
                {" · "}
                {t("tickets.ladder.current")}
              </span>
            )}
          </span>
          <span class="flex flex-wrap items-baseline justify-end gap-x-2 gap-y-0.5 sm:justify-start">
            <span
              class:list={[
                "text-lg font-bold tracking-[-0.02em] tabular-nums",
                state === "past" &&
                  "decoration-muted-foreground/50 line-through decoration-[1.5px]",
              ]}
            >
              {formatPrice(tier.price, lang)}
            </span>
            {state === "past" && (
              <span class="text-muted-foreground inline-flex items-center gap-1 text-xs font-semibold tracking-[0.05em] uppercase">
                <Icon name="ban" size={12} />
                {t("tickets.ladder.sold_out")}
              </span>
            )}
          </span>

          {/* The chevron to the next tier, in the gutter: down on mobile, along the row from sm. */}
          {index < items.length - 1 && (
            <span
              aria-hidden="true"
              class="text-muted-foreground/60 pointer-events-none absolute top-full left-1/2 -translate-x-1/2 translate-y-0.5 sm:top-1/2 sm:left-full sm:translate-x-1.5 sm:-translate-y-1/2"
            >
              <Icon
                name="chevron-right"
                size={16}
                class="rotate-90 sm:rotate-0"
              />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</div>
