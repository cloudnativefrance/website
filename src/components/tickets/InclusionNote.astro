---
/**
 * Inclusion and students, at the foot of the page: discreet, never hidden, no
 * price — every request is looked at case by case. The same answer lives in
 * the FAQ for anyone who searches rather than scrolls.
 */
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
  inclusionMailto: string;
}

const { lang, inclusionMailto } = Astro.props;
const t = useTranslations(lang);
---

<aside class="mx-auto max-w-[62ch] text-center text-base text-muted-foreground text-pretty" aria-label={t("tickets.faq.inclusion.q")}>
  {t("tickets.inclusion.text")}{" "}
  <a
    href={inclusionMailto}
    class="font-medium text-primary-strong underline underline-offset-4 decoration-primary-strong/40 hover:decoration-primary-strong"
    data-umami-event="tickets-inclusion-contact"
    data-umami-event-source="footer"
  >
    {t("tickets.inclusion.cta")}
  </a>
</aside>
