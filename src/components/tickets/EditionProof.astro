---
/**
 * Until the 2027 programme exists, the last edition is the proof: the
 * published attendance figure, the organisations that gave an experience
 * report (read from the 2026 sessions), real photos and the replays. No
 * testimonial, no invented number.
 */
import { Picture } from "astro:assets";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import type { RexSummary } from "@/lib/tickets/rex";
import { fill } from "@/lib/tickets/format";
import { EDITION_2026 } from "@/lib/editions-data";
import TopReplaysStrip from "@/components/past-editions/TopReplaysStrip.astro";
import hallPhoto from "@/assets/photos/ambiance/ambiance-06.jpg";
import villagePhoto from "@/assets/photos/ambiance/ambiance-03.jpg";
import Icon from "./Icon.astro";
import Tbd from "./Tbd.astro";

interface Props {
  lang: Locale;
  rex: RexSummary;
  programmeWhen: string;
  programmeNote?: string;
}

const { lang, rex, programmeWhen, programmeNote } = Astro.props;
const t = useTranslations(lang);
const photoAlt =
  lang === "fr"
    ? { hall: "La grande salle du CENTQUATRE-PARIS, pleine, pendant CND France 2026", village: "Le village partenaires de CND France 2026 vu d'en haut" }
    : { hall: "The main hall at CENTQUATRE-PARIS, full, during CND France 2026", village: "The CND France 2026 partner village seen from above" };
---

<section class="flex flex-col gap-12" aria-labelledby="proof-title">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-10 px-4 md:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-end lg:gap-14">
      <div class="flex flex-col gap-5">
        <h2 id="proof-title" class="text-3xl font-bold tracking-[-0.02em] text-balance text-foreground sm:text-4xl">
          {t("tickets.proof.title")}
        </h2>
        <p class="max-w-[30ch] text-2xl font-semibold leading-snug tracking-[-0.01em] text-foreground text-balance sm:text-3xl">
          {t("tickets.proof.lead")}
        </p>
        <p class="flex flex-wrap items-center gap-2 text-base text-muted-foreground text-pretty">
          {fill(t("tickets.proof.programme"), { when: programmeWhen })}
          {programmeNote && <Tbd note={programmeNote} lang={lang} />}
        </p>
      </div>
      <div class="grid grid-cols-[1.6fr_1fr] gap-3 sm:gap-4">
        <Picture
          src={hallPhoto}
          alt={photoAlt.hall}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 34vw, 60vw"
          formats={["avif", "webp"]}
          loading="lazy"
          decoding="async"
          class="proof-photo aspect-[4/3] h-full w-full rounded-lg object-cover"
        />
        <Picture
          src={villagePhoto}
          alt={photoAlt.village}
          widths={[320, 560, 800]}
          sizes="(min-width: 1024px) 22vw, 38vw"
          formats={["avif", "webp"]}
          loading="lazy"
          decoding="async"
          class="proof-photo aspect-[3/4] h-full w-full rounded-lg object-cover object-[60%_50%]"
        />
      </div>
    </div>

    {rex.sessions > 0 && (
      <div class="flex flex-col gap-4 border-t border-border pt-8">
        <p class="text-base font-medium text-muted-foreground">{fill(t("tickets.proof.rex"), { n: rex.sessions })}</p>
        <ul class="flex flex-wrap gap-x-7 gap-y-2" data-rex-organisations>
          {rex.organisations.map((organisation) => (
            <li class="text-xl font-semibold tracking-[-0.01em] text-foreground sm:text-2xl">{organisation}</li>
          ))}
        </ul>
      </div>
    )}

    <div class="flex flex-wrap items-center justify-between gap-4">
      <h3 class="text-xl font-semibold tracking-[-0.01em] text-foreground">{t("tickets.proof.replays")}</h3>
      <a
        href={EDITION_2026.galleryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-strong underline-offset-4 hover:underline"
      >
        {t("tickets.proof.photos")}
        <Icon name="external" size={14} />
      </a>
    </div>
  </div>

  <TopReplaysStrip replays={EDITION_2026.topReplays} playlistUrl={EDITION_2026.replaysUrl} viewAllKey="discover.replays.cta" class="-mt-6 w-full" />
</section>

<style>
  .proof-photo {
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }
  :global(.dark) .proof-photo {
    outline-color: oklch(1 0 0 / 0.1);
  }
</style>
