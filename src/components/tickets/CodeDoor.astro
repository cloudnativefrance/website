---
/**
 * Door 3, "I have a code": partners, invitations, promo codes. The site checks
 * nothing and prices nothing — it hands the code to alf.io, which knows them.
 *
 * A slim full-width band under the tickets, in every phase (27/09/2026): a
 * short card beside a tall one leaves a hole, a band does not. It is never
 * rendered before the ticketing opens, where a code has nothing to buy.
 *
 * Without JavaScript the form is a plain GET to the listing with `?code=`, in
 * a new tab (support to confirm with JC); `tickets-ui.ts` upgrades it to
 * `/code/<CODE>` (a new tab too, `openInNewTab`), strips whitespace and
 * refuses an empty code with a message.
 * The hand-off to the ticketing host is announced before the click.
 */
import type { TierId } from "@/config/tickets";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { fill } from "@/lib/tickets/format";
import Icon from "./Icon.astro";

interface Props {
  lang: Locale;
  phase: TierId;
  listingUrl: string;
  fallback: { action: string; param: "code" };
  host: string;
}

const { lang, phase, listingUrl, fallback, host } = Astro.props;
const t = useTranslations(lang);
---

<article
  class="door border-border bg-card flex flex-col gap-4 rounded-xl border p-5 sm:px-8 sm:py-6 lg:flex-row lg:items-center lg:gap-8"
  aria-labelledby="door-code-title"
>
  <div class="flex flex-col gap-1 lg:shrink-0">
    <h2
      id="door-code-title"
      class="text-foreground text-2xl font-semibold tracking-[-0.01em]"
    >
      {t("tickets.door.code")}
    </h2>
    <p class="text-muted-foreground text-sm">{t("tickets.code.intro")}</p>
  </div>

  <form
    method="get"
    action={fallback.action}
    target="_blank"
    class="flex flex-col gap-2 lg:min-w-0 lg:flex-1 lg:flex-row lg:items-center lg:gap-6"
    novalidate
    data-tickets-code
    data-listing={listingUrl}
  >
    <label for="ticket-code" class="sr-only">
      {t("tickets.code.intro")}
      <span class="sr-only">{t("tickets.code.label")}</span>
    </label>
    {
      /* A code is short: the field keeps a sensible width and the hand-off
        note takes the rest of the row rather than trailing under it. */
    }
    <div class="flex flex-col gap-2 lg:max-w-md lg:min-w-0 lg:flex-1">
      <div class="flex flex-col gap-2 min-[380px]:flex-row">
        <input
          id="ticket-code"
          name={fallback.param}
          type="text"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          enterkeyhint="go"
          placeholder={t("tickets.code.label")}
          aria-describedby="ticket-code-handoff"
          class="border-input bg-background text-foreground caret-primary placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/40 aria-invalid:border-destructive-strong aria-invalid:ring-destructive/20 h-11 min-w-0 flex-1 rounded-lg border px-3 text-base transition-[border-color,box-shadow] duration-150 focus-visible:ring-3 focus-visible:outline-none aria-invalid:ring-3"
          data-code-input
        />
        {
          /* `whitespace-nowrap` from lg only, where the band puts it on one row:
          on a phone it would make the door's min-content wider than the
          viewport and push the whole grid column out. */
        }
        <button
          type="submit"
          class="border-input bg-card text-foreground hover:bg-muted focus-visible:ring-ring/50 inline-flex h-11 items-center justify-center gap-2 rounded-lg border px-4 text-base font-semibold transition-[background-color,scale] duration-150 ease-out focus-visible:ring-3 focus-visible:outline-none active:scale-[0.96] lg:whitespace-nowrap"
          data-umami-event="tickets-code"
          data-umami-event-phase={phase}
        >
          {t("tickets.code.submit")}
          <span class="sr-only"> {t("tickets.new_tab")}</span>
          <Icon name="arrow-right" size={16} />
        </button>
      </div>
      <p
        id="ticket-code-error"
        class="text-destructive-strong text-sm font-medium"
        role="alert"
        hidden
        data-code-error
      >
        {t("tickets.code.empty")}
      </p>
    </div>
    <p
      id="ticket-code-handoff"
      class="text-muted-foreground text-sm text-pretty lg:max-w-[34ch]"
    >
      {fill(t("tickets.code.handoff"), { host })}
    </p>
  </form>
</article>
