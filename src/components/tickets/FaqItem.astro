---
/** A FAQ entry as native <details>: disclosure for free, no JavaScript. */
import Icon from "./Icon.astro";

interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details class="faq">
  <summary>{question}<Icon name="plus" size={18} class="faq-icon" /></summary>
  <p><slot /></p>
</details>

<style>
  .faq > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
    border-radius: var(--radius-sm);
  }
  .faq > summary::-webkit-details-marker {
    display: none;
  }
  .faq > summary:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .faq > summary :global(.faq-icon) {
    color: var(--color-muted-foreground);
    transition: rotate 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .faq[open] > summary :global(.faq-icon) {
    rotate: 45deg;
  }
  .faq > p {
    max-width: 68ch;
    padding-bottom: 1.25rem;
    color: var(--color-muted-foreground);
    text-wrap: pretty;
  }
</style>
