---
/**
 * The group rates of the moment, as a price list in door 2.
 *
 * Read as information, not as options to pick (27/09/2026): no box around a
 * row, no hover — one line per rate between hairlines, the group size on the
 * left, the price per seat on the right with its discount against the current
 * tier stuck to it as a price tag, in the section's pink (the "Stock limité"
 * family, a size smaller). Pink text alone would not pass contrast on a white
 * card; the tag's dark ink does. Nothing is clickable: door 2's own call to
 * action is the way to ask for a rate.
 */
import type { GroupRate, TierDefinition } from "@/config/tickets";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { formatDiscount, formatPrice } from "@/lib/tickets/format";

interface Props {
  lang: Locale;
  /** The tier the discount is measured against — the price on offer today. */
  tier: TierDefinition;
  rates: GroupRate[];
  class?: string;
}

const { lang, tier, rates, class: className } = Astro.props;
const t = useTranslations(lang);
---

{
  /* One grid for the whole list, each row a subgrid: the prices share a column,
    so they start on the same line whatever the width of the tag after them
    ("−15 %" is narrower than "−25 %"). */
}
<dl
  class:list={[
    "divide-border border-border grid grid-cols-[1fr_auto_auto] gap-x-2 divide-y border-y",
    className,
  ]}
>
  {
    rates.map((rate) => (
      <div
        class="col-span-3 grid grid-cols-subgrid items-baseline py-3.5"
        data-group-rate={rate.id}
      >
        <dt class="text-muted-foreground pr-2 text-sm">
          {t(`tickets.team.rate.${rate.id}`)}
        </dt>
        <dd class="text-foreground text-xl font-semibold tracking-[-0.01em] whitespace-nowrap tabular-nums">
          {formatPrice(rate.price, lang)}
        </dd>
        <dd
          class="bg-accent text-accent-foreground self-center justify-self-start rounded-full px-1.5 py-0.5 text-xs leading-none font-bold whitespace-nowrap tabular-nums"
          data-group-discount
        >
          {formatDiscount(tier.price, rate.price, lang)}
        </dd>
      </div>
    ))
  }
</dl>
