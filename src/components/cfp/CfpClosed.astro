---
/**
 * The `closed` phase: the deadline has passed, the programme is next. The
 * layout's newsletter band stays on — it is the page's only action.
 */
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<main class="mx-auto max-w-3xl px-4 py-24 text-center md:px-6 md:py-32">
  <h1
    class="text-foreground text-4xl font-bold tracking-tight md:text-5xl"
    style="letter-spacing:-0.02em;"
  >
    {t("cfp.closed.title")}
  </h1>
  <p class="text-muted-foreground mt-6 text-base md:text-lg">
    {t("cfp.closed.body")}
  </p>
</main>
