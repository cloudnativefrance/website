---
/**
 * The `open` phase: the CFP page itself, ported from the staging routes.
 * Both locales' page copy lives here, keyed by lang; the markup is shared.
 * The staging pages duplicated the markup per locale because they
 * were pages — as one component there is exactly one copy of the JSX, so
 * the FR and EN trees cannot drift apart while editors work on one of them.
 * The themes and formats are the exception: they live in cfp-content.ts,
 * shared with the closed page, which keeps showing them after the deadline.
 */
import { Picture } from "astro:assets";
import type { Locale } from "@/i18n/ui";
import { getLocalePath } from "@/i18n/utils";
import { cfpSubmitUrl, cfpSubmitLabel } from "@/lib/pretalx";
import { CFP_CONTENT } from "./cfp-content";
import intervenantPhoto from "@/assets/photos/contact/intervenants.jpg";
import participantPhoto from "@/assets/photos/contact/participant.jpg";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const CFP_URL = cfpSubmitUrl();
const CFP_LABEL = cfpSubmitLabel();

const fr = {
  badge: "CFP 2027 · ouvert",
  heroTitle: "Et si vous montiez sur scène ?",
  heroSub: "Une journée. 7 thèmes. 3 formats. Et votre voix.",
  heroCta: "Soumettre une proposition",
  formatsLink: null as string | null,
  eventLine:
    "3 juin 2027 · CENTQUATRE-PARIS · au cœur de la communauté francophone du Cloud Native",
  deadlineLine: "Date limite\u00a0: 31 janvier 2027",
  multiTopics:
    "Envie de proposer plusieurs sujets ? Soumettez une proposition séparée pour chacun et le comité les évaluera indépendamment. Privilégiez la qualité plutôt que la quantité\u00a0: présenter plusieurs sujets n'augmente pas vos chances automatiquement.",
  knowTitle: "À savoir",
  knowFrench: {
    before: "Toutes les présentations se déroulent ",
    strong: "en français",
    after:
      " ; les slides en anglais sont acceptés si cela facilite votre préparation.",
  },
  coaching: {
    strong: "Première fois sur scène, ou envie d'un regard extérieur ?",
    body: "Un coaching vous accompagne pour préparer votre proposition et votre prise de parole, avant comme après la clôture du CFP. Pour en bénéficier, écrivez à ",
  },
  knowCosp:
    "Présenter à plusieurs ? Les co-intervenants sont les bienvenus sur tous les formats\u00a0: ajoutez-les à votre soumission, chacun complète son profil.",
  knowValues: {
    label: "Nos valeurs",
    colon: " : ",
    items: [
      { emoji: "❤️", text: "Communauté" },
      { emoji: "🌍", text: "Inclusion et diversité" },
      { emoji: "🌱", text: "Écologie" },
      { emoji: "🗝️", text: "Autonomie numérique" },
    ],
  },
  knowCoc: {
    before: "L'événement se déroule selon notre ",
    link: "code de conduite",
    after: "",
  },
  knowInfo: {
    before: "Pour toute information",
    sep: " : ",
    email: "speakers@cloudnativedays.fr",
  },
  committeeTitle: "Nos critères de sélection",
  committeeIntro:
    "Notre comité de sélection, composé de bénévoles de l'organisation et de membres des communautés Cloud Native francophones, sera particulièrement attentif aux points suivants\u00a0:",
  noPitch:
    "Les présentations promotionnelles ou commerciales ne sont pas acceptées et sont automatiquement refusées.",
  committeeClosing:
    "Il n'est pas nécessaire de répondre à tous ces critères : nous recherchons avant tout des conférences qui permettent aux participants d'apprendre, de découvrir ou de questionner leurs pratiques.",
  closingTitle: "Vous avez quelque chose à raconter. Nous avons la scène.",
  closingCta: "Soumettre une proposition",
  closingDeadline: "Clôture le 31 janvier 2027",
  heroPhotoAlt: "Intervenant(e) sur scène à Cloud Native Days France 2026",
  closingPhotoAlt: "Participantes et participants à Cloud Native Days France 2026",
  criteria: [
    {
      key: "Retours d'expérience",
      body: "des enseignements utiles et concrets issus de projets opérationnels ou d'expérimentations, de réussites comme d'échecs.",
    },
    {
      key: "Innovation et expertise",
      body: "des contenus solides, des approches originales, avec de la profondeur technique et adaptés au format sélectionné.",
    },
    {
      key: "Open source et contribution communautaire",
      body: "une attention particulière aux technologies ouvertes, aux projets collaboratifs et au partage des connaissances.",
    },
    {
      key: "Originalité du contenu",
      body: "priorité aux conférences inédites, des angles nouveaux et des approches qui sortent des sentiers battus.",
    },
    {
      key: "Diversité",
      body: "une programmation ouverte à la diversité des profils, des parcours, des expériences et des points de vue.",
    },
    {
      key: "Écosystème francophone",
      body: "une attention particulière aux projets, initiatives et expériences issus des organisations et des communautés francophones.",
    },
  ],
};

const COPY: Record<Locale, typeof fr> = {
  fr,
  en: {
    badge: "CFP 2027 · open",
    heroTitle: "What if you took the stage?",
    heroSub: "One day. 7 themes. 3 formats. And your voice.",
    heroCta: "Submit a proposal",
    formatsLink: "See the formats",
    eventLine:
      "June 3, 2027 · CENTQUATRE-PARIS · at the heart of the French-speaking Cloud Native community",
    deadlineLine: "Deadline: January 31, 2027",
    multiTopics:
      "Want to submit several topics? Send a separate proposal for each and the committee evaluates them independently. Favour quality over quantity: submitting multiple proposals does not automatically increase your chances.",
    knowTitle: "Good to know",
    knowFrench: {
      before: "All talks are ",
      strong: "in French",
      after: "; English slides are accepted if that makes prep easier.",
    },
    coaching: {
      strong: "First time on stage, or looking for an outside perspective?",
      body: "Dedicated coaching supports you in preparing your proposal and your talk, before and after the CFP closes. To benefit, write to ",
    },
    knowCosp:
      "Presenting as a pair? Co-speakers are welcome on every format: add them to your submission, and each of you completes your own profile.",
    knowValues: {
      label: "Our values",
      colon: ": ",
      items: [
        { emoji: "❤️", text: "Community" },
        { emoji: "🌍", text: "Inclusion & diversity" },
        { emoji: "🌱", text: "Ecology" },
        { emoji: "🗝️", text: "Digital sovereignty" },
      ],
    },
    knowCoc: {
      before: "The event runs under our ",
      link: "code of conduct",
      after: "",
    },
    knowInfo: {
      before: "For anything else",
      sep: ": ",
      email: "speakers@cloudnativedays.fr",
    },
    committeeTitle: "Our selection criteria",
    committeeIntro:
      "Our selection committee — volunteers from the CND France organization and members of the French-speaking Cloud Native communities — will pay particular attention to the following:",
    noPitch:
      "Promotional or commercial talks are not accepted and will be automatically rejected.",
    committeeClosing:
      "You don't need to meet all of these criteria: above all, we're looking for talks that let attendees learn, discover, or question their practices.",
    closingTitle: "You have something to say. We have the stage.",
    closingCta: "Submit a proposal",
    closingDeadline: "Submissions close January 31, 2027.",
    heroPhotoAlt: "Speaker on stage at Cloud Native Days France 2026",
    closingPhotoAlt: "Attendees at Cloud Native Days France 2026",
    criteria: [
      {
        key: "Experience reports",
        body: "useful, concrete lessons from operational projects or experiments, successes and failures alike.",
      },
      {
        key: "Innovation and expertise",
        body: "solid content, original approaches, technical depth, adapted to the selected format.",
      },
      {
        key: "Open source and community contribution",
        body: "particular attention to open technologies, collaborative projects and knowledge sharing.",
      },
      {
        key: "Original content",
        body: "priority to talks that have not been given before, fresh angles and approaches off the beaten track.",
      },
      {
        key: "Diversity",
        body: "a programme open to a diversity of profiles, backgrounds, experiences and points of view.",
      },
      {
        key: "French-speaking ecosystem",
        body: "particular attention to projects, initiatives and experiences from French-speaking organizations and communities.",
      },
    ],
  },
};

const copy = COPY[lang];
// Themes and formats come from the shared module — the closed page renders
// the same grids from the same data (cfp-content.ts).
const content = CFP_CONTENT[lang];
// Both contact routes are in-page actions: the code-of-conduct path follows
// the locale, the coaching/info line hands people straight to a mail client.
const COC_PATH = getLocalePath(lang, "/code-of-conduct");
const SPEAKERS_MAILTO = "mailto:speakers@cloudnativedays.fr";
---

<main>
  <section class="mx-auto max-w-6xl px-4 md:px-6 pt-16 md:pt-24 pb-10 md:pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div>
        <span
          class="inline-flex items-center rounded-full bg-green-600 px-3 py-1 text-xs font-semibold tracking-wider text-white uppercase"
        >
          {copy.badge}
        </span>
        <h1 class="mt-5 text-4xl md:text-6xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
          {copy.heroTitle}
        </h1>
        <p class="mt-4 text-base md:text-lg text-muted-foreground">
          {copy.heroSub}
        </p>
        <a
          href={CFP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-primary text-primary-foreground text-base font-semibold px-6 h-12 transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          {copy.heroCta} <span aria-hidden="true">→</span>
        </a>
        <p
          class="mt-3 text-base font-semibold text-red-600 md:text-lg dark:text-red-400"
        >
          {copy.deadlineLine}
        </p>
        {copy.formatsLink && (
          <p class="mt-3 text-sm">
            <a
              href="#formats"
              class="font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              {copy.formatsLink}
            </a>
          </p>
        )}
        <p class="mt-4 text-sm text-muted-foreground">
          {copy.eventLine}
        </p>
      </div>
      <Picture
        src={intervenantPhoto}
        alt={copy.heroPhotoAlt}
        widths={[400, 600, 800, 1200]}
        sizes="(min-width: 768px) 45vw, 100vw"
        formats={["avif", "webp"]}
        loading="eager"
        decoding="async"
        class="w-full aspect-[4/3] object-cover rounded-lg border border-border"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 md:px-6 py-10 md:py-12">
    <h2 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
      {content.themesTitle}
    </h2>
    <p class="mt-2 text-sm md:text-base text-muted-foreground">
      {content.themesSub}
    </p>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        content.parcours.map((th) => (
          <article class="rounded-lg border border-border bg-card p-4 md:p-5 transition-colors hover:border-primary/60">
            <div class="flex items-center gap-3">
              <div class="inline-flex items-center justify-center w-9 h-9 rounded-full text-lg bg-primary/10 shrink-0" aria-hidden="true">
                {th.emoji}
              </div>
              <h3 class="text-base md:text-lg font-bold text-foreground tracking-tight">
                {th.title}
              </h3>
            </div>
            <p class="mt-2 text-sm md:text-base text-muted-foreground leading-relaxed">
              {th.body}
            </p>
          </article>
        ))
      }
      <article class="sm:col-span-2 lg:col-span-3 rounded-lg border border-border bg-card p-4 md:p-5 transition-colors hover:border-primary/60">
        <div class="flex items-center gap-3">
          <div class="inline-flex items-center justify-center w-9 h-9 rounded-full text-lg bg-primary/10 shrink-0" aria-hidden="true">
            {content.horsPiste.emoji}
          </div>
          <h3 class="text-base md:text-lg font-bold text-foreground tracking-tight">
            {content.horsPiste.title}
          </h3>
        </div>
        <p class="mt-2 text-sm md:text-base text-muted-foreground leading-relaxed">
          {content.horsPiste.body}
        </p>
      </article>
    </div>
    <p class="mt-4 rounded-lg border border-primary/40 bg-primary/10 px-5 py-4 text-sm md:text-base text-foreground leading-relaxed">
      {copy.multiTopics}
    </p>
  </section>

  <section id="formats" class="mx-auto max-w-6xl px-4 md:px-6 py-10 md:py-12">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12">
      <div>
        <h3 class="text-xl font-bold text-foreground tracking-tight">
          {content.formatsTitle}
        </h3>
        <ul role="list" class="mt-5 space-y-5">
          {
            content.formats.map((f) => (
              <li>
                <div class="flex items-center gap-3">
                  <span class="shrink-0 inline-flex items-center rounded-full bg-primary/10 text-primary px-3 py-1.5 text-xs md:text-sm font-bold">
                    {f.duration}
                  </span>
                  <h4 class="text-base md:text-lg font-bold text-foreground tracking-tight">
                    {f.title}
                  </h4>
                </div>
                <p class="mt-1.5 text-sm md:text-base text-muted-foreground leading-relaxed">
                  {f.body}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-bold text-foreground tracking-tight">
          {copy.knowTitle}
        </h3>
        <ul role="list" class="mt-5 space-y-4">
          <li class="text-sm md:text-base text-muted-foreground leading-relaxed">
            <span aria-hidden="true">🇫🇷</span> {copy.knowFrench.before}
            <strong class="font-semibold text-foreground">{copy.knowFrench.strong}</strong>
            {copy.knowFrench.after}
          </li>
          <li
            class="text-muted-foreground text-sm leading-relaxed md:text-base"
          >
            <span aria-hidden="true">👥</span>
            {copy.knowCosp}
          </li>
          <li class="text-sm md:text-base text-muted-foreground leading-relaxed">
            <strong class="font-semibold text-foreground">{copy.knowValues.label}</strong>
            {copy.knowValues.colon}
            {
              copy.knowValues.items.map((v, i) => (
                <>
                  {i > 0 && " · "}
                  <span aria-hidden="true">{v.emoji}</span> {v.text}
                </>
              ))
            }
          </li>
          <li class="text-sm md:text-base text-muted-foreground leading-relaxed">
            {copy.knowCoc.before}
            <a
              href={COC_PATH}
              class="font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              {copy.knowCoc.link}
            </a>
            {copy.knowCoc.after}
          </li>
          <li class="text-sm md:text-base text-muted-foreground leading-relaxed">
            {copy.knowInfo.before}{copy.knowInfo.sep}
            <a
              href={SPEAKERS_MAILTO}
              class="font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              {copy.knowInfo.email}
            </a>
          </li>
        </ul>
        <div class="border-primary/40 bg-primary/10 mt-6 rounded-lg border p-4">
          <p class="text-foreground text-sm leading-relaxed md:text-base">
            <span aria-hidden="true">🎤</span>{" "}
            <strong class="text-foreground font-semibold"
              >{copy.coaching.strong}</strong
            >{" "}
            {copy.coaching.body}
            <a
              href={SPEAKERS_MAILTO}
              class="text-primary focus-visible:ring-ring font-medium underline-offset-4 hover:underline focus-visible:ring-2 focus-visible:outline-none"
            >
              speakers@cloudnativedays.fr
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 md:px-6 py-10 md:py-12">
    <h2 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
      {copy.committeeTitle}
    </h2>
    <p class="mt-4 text-base md:text-lg text-muted-foreground leading-relaxed">
      {copy.committeeIntro}
    </p>
    <p class="text-foreground mt-4 text-base font-bold md:text-lg">
      {copy.noPitch}
    </p>
    <ul role="list" class="mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-5">
      {
        copy.criteria.map((c) => (
          <li>
            <div class="flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 mt-0.5 text-primary"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <p class="text-base md:text-lg font-bold text-foreground tracking-tight">
                {c.key}
              </p>
            </div>
            <p class="ms-[34px] mt-1 text-sm md:text-base text-muted-foreground leading-relaxed">
              {c.body}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm md:text-base text-muted-foreground leading-relaxed">
      {copy.committeeClosing}
    </p>
  </section>

  <section class="mt-8 bg-card border-y border-border">
    <div class="mx-auto max-w-6xl px-4 md:px-6 py-12 md:py-16 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight" style="letter-spacing:-0.02em;">
          {copy.closingTitle}
        </h2>
        <a
          href={CFP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-primary text-primary-foreground text-base md:text-lg font-semibold px-8 h-14 transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          {copy.closingCta} <span aria-hidden="true">→</span>
        </a>
        <p
          class="mt-4 text-base font-semibold text-red-600 md:text-lg dark:text-red-400"
        >
          {copy.closingDeadline}
        </p>
        <p class="mt-1 text-xs text-muted-foreground">{CFP_LABEL}</p>
      </div>
      <Picture
        src={participantPhoto}
        alt={copy.closingPhotoAlt}
        widths={[400, 600, 800, 1200]}
        sizes="(min-width: 768px) 45vw, 100vw"
        formats={["avif", "webp"]}
        loading="lazy"
        decoding="async"
        class="w-full aspect-[4/3] object-cover rounded-lg border border-border"
      />
    </div>
  </section>
</main>
