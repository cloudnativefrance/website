---
import { cn } from "@/lib/utils";
import { getImage } from "astro:assets";

interface Props {
  name: string;
  photo?: string;
  /** Committed portrait, used only if the Pretalx one cannot be read. */
  fallback?: string;
  size?: "sm" | "lg";
  class?: string;
}

const { name, photo, fallback, size = "sm", class: className } = Astro.props;

/** 2x the CSS box, so the portrait stays sharp on a retina screen. */
const RENDER_WIDTH = { sm: 128, lg: 256 };

/**
 * Astro's remote-size probe is not memoised, and each speaker is rendered on
 * four pages (FR index, EN index, FR detail, EN detail). Without this the 2026
 * build made 260 HTTP round-trips for 65 distinct avatars and a cold build —
 * which is every CI and Docker build — cost about 74 seconds more than a warm
 * one. Keyed by URL and width because the two sizes are different derivatives.
 */
// On `globalThis`, not a module-level const: Astro re-instantiates this
// component's module per page, so a plain module scope gave 260 misses for 65
// avatars — measured, not assumed. The build process is the natural lifetime.
const optimised: Map<string, Promise<string>> = ((globalThis as Record<string, unknown>)
  .__cndSpeakerPortraits ??= new Map<string, Promise<string>>()) as Map<string, Promise<string>>;
function optimise(url: string, width: number): Promise<string> {
  const key = `${width}|${url}`;
  let pending = optimised.get(key);
  if (!pending) {
    // `inferSize` is required for a remote source: Astro cannot know the aspect
    // ratio without reading the file, and without dimensions it declines to
    // optimise and hands the original URL straight back — silently, which is
    // how this first appeared to "work" while still emitting 65 hotlinks.
    // Both dimensions, explicitly, plus `fit: "cover"`.
    //
    // Passing `width` alone looks right — the box is square, so the aspect
    // ratio should follow — but for a REMOTE source resolved via `inferSize`
    // it emitted `height` unchanged from the original: a 1024x1058 portrait
    // came back as 128x1058, squashed 8x horizontally. `object-cover` then
    // cropped the middle of that sliver, so every Pretalx portrait rendered as
    // a close-up of a nose or an eye. Measured, not theorised: see the guard in
    // tests/build/speaker-avatar-aspect.test.ts.
    //
    // A square derivative is what this component wants regardless — the box is
    // `w-16 h-16` / `w-32 h-32` and clipped to a circle — so asking sharp for a
    // centred square crop moves the decision to build time, where it can be
    // asserted, instead of leaving it to CSS on an image of unknown shape.
    pending = getImage({
      src: url,
      inferSize: true,
      width,
      height: width,
      fit: "cover",
      format: "webp",
    }).then((r) => r.src);
    optimised.set(key, pending);
  }
  return pending;
}

/**
 * Portraits come from Pretalx as absolute URLs. Left alone they would be
 * hotlinked: one cross-origin request per speaker on a page that shows 77 of
 * them, unoptimised, and broken for visitors whenever Pretalx is down.
 * `getImage()` downloads and re-encodes each one at build time into
 * `/_astro/`, so the browser only ever talks to our own origin.
 *
 * The try/catch is the point. A remote fetch inside a build is exactly the
 * dependency that made a Pretalx outage fatal once already, so a failure here
 * must never fail the deploy.
 *
 * On failure it degrades to the COMMITTED portrait, and only to initials if
 * there is none. Never to the original URL: this fires when the image could not
 * be read — one 2026 avatar is a zero-byte file in Pretalx — so hotlinking it
 * renders a broken-image icon where initials render fine, and it keeps "no
 * portrait is ever hotlinked" a property the build can be tested against.
 *
 * The committed rung is load-bearing, not belt-and-braces. Without it a Pretalx
 * avatar outage blanks 65 of 77 faces, exit 0, inside a release image built with
 * PRETALX_TOKEN_REQUIRED=1 — the exact class of silent regression that flag
 * exists to stop. Verified by stubbing 503 on /media/avatars/.
 */
let src = photo;
if (photo && /^https?:\/\//.test(photo)) {
  try {
    src = await optimise(photo, RENDER_WIDTH[size]);
  } catch (err) {
    src = fallback || undefined;
    const reason = err instanceof Error ? err.message : String(err);
    console.warn(
      `[speakers] ${name}: could not read the Pretalx portrait ${photo} (${reason}) — ` +
        `${src ? "using the committed portrait" : "showing initials"}. ` +
        `Re-upload the avatar in Pretalx.`,
    );
  }
}

const initials = name
  .split(" ")
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const sizeClasses = {
  sm: "w-16 h-16 rounded-full",
  lg: "w-32 h-32 rounded-xl",
};

const initialsSizeClasses = {
  sm: "text-base",
  lg: "text-3xl",
};
---

{
  src ? (
    <img
      src={src}
      alt={name}
      loading="lazy"
      decoding="async"
      class={cn(
        sizeClasses[size],
        "object-cover",
        // Rule 11: pure black/white at low alpha, never a tinted neutral —
        // a tint picks up the surface beneath and reads as dirt on the edge.
        "outline outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10",
        className,
      )}
    />
  ) : (
    <div
      class={cn(
        sizeClasses[size],
        "bg-secondary flex items-center justify-center font-bold text-muted-foreground",
        initialsSizeClasses[size],
        className,
      )}
      aria-label={name}
    >
      {initials}
    </div>
  )
}
