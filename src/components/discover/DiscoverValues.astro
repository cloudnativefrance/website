---
interface Stats {
  participants: string;
  talks: string;
  speakers: string;
  tracks: string;
}

interface Props {
  title: string;
  body: string;
  stats: Stats;
  lang: "fr" | "en";
}

const { title, body, stats, lang } = Astro.props;

const valueLabels = {
  fr: [
    { emoji: "🔓", label: "Autonomie Numérique" },
    { emoji: "🤝", label: "Communauté" },
    { emoji: "🌈", label: "Inclusion" },
    { emoji: "🌿", label: "Écologie" },
  ],
  en: [
    { emoji: "🔓", label: "Digital Autonomy" },
    { emoji: "🤝", label: "Community" },
    { emoji: "🌈", label: "Inclusion" },
    { emoji: "🌿", label: "Ecology" },
  ],
} as const;

const statItems = [
  { number: "2 500", suffix: "+", label: stats.participants },
  { number: "50",    suffix: "+", label: stats.talks },
  { number: "50",    suffix: "+", label: stats.speakers },
  { number: "5",     suffix: "",  label: stats.tracks },
];
---

<section id="values" class="bg-card">
  <div class="mx-auto max-w-7xl px-4 md:px-6 py-16">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold text-foreground mb-6">{title}</h2>
        <p class="text-muted-foreground leading-relaxed">{body}</p>
      </div>
      <div class="flex flex-wrap gap-8 justify-center md:justify-end">
        {valueLabels[lang].map(({ emoji, label }) => (
          <div class="flex flex-col items-center gap-2">
            <span class="text-5xl" aria-hidden="true">{emoji}</span>
            <span class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">{label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-8 border-t border-border pt-8">
      {statItems.map(({ number, suffix, label }) => (
        <div class="text-center">
          <div class="text-4xl font-bold text-primary">
            {number}<span class="text-destructive">{suffix}</span>
          </div>
          <div class="text-sm font-semibold uppercase tracking-wide text-muted-foreground mt-2">{label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
