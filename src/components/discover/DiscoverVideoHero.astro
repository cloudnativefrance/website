---
interface Props {
  title: string;
  subtitle: string;
  bestofCaption: string;
  coulissesCaption: string;
}

const { title, subtitle, bestofCaption, coulissesCaption } = Astro.props;

const BESTOF_ID    = "qyMGuU2-w8o";
const COULISSES_ID = "A51PGVvrt_8";
---

<section class="w-full bg-background">
  <div class="mx-auto max-w-7xl px-4 md:px-6 pt-16 pb-8">
    <div class="text-center mb-10">
      <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-4">{title}</h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">{subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Best of — le "quoi" -->
      <div class="flex flex-col gap-3">
        <div class="relative w-full aspect-video rounded-xl overflow-hidden">
          <iframe
            class="absolute inset-0 w-full h-full"
            src={`https://www.youtube-nocookie.com/embed/${BESTOF_ID}`}
            title={bestofCaption}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <p class="text-center text-sm font-medium text-muted-foreground">{bestofCaption}</p>
      </div>

      <!-- Coulisses — les valeurs et le "comment" -->
      <div class="flex flex-col gap-3">
        <div class="relative w-full aspect-video rounded-xl overflow-hidden">
          <iframe
            class="absolute inset-0 w-full h-full"
            src={`https://www.youtube-nocookie.com/embed/${COULISSES_ID}`}
            title={coulissesCaption}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <p class="text-center text-sm font-medium text-muted-foreground">{coulissesCaption}</p>
      </div>
    </div>
  </div>
</section>
