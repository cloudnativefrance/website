---
interface Props {
  p1: string;
  p2: string;
  highlightsTitle: string;
  highlightsTalks: string;
  highlightsPartners: string;
}

const { p1, p2, highlightsTitle, highlightsTalks, highlightsPartners } = Astro.props;
---

<section class="bg-background">
  <div class="mx-auto max-w-3xl px-4 md:px-6 py-12 md:py-16 space-y-6 text-muted-foreground leading-relaxed">
    <p class="text-base md:text-lg">{p1}</p>
    <p class="text-base md:text-lg">{p2}</p>

    <div>
      <p class="text-base md:text-lg font-semibold text-foreground mb-4">{highlightsTitle}</p>
      <ul class="space-y-3 list-none">
        <li class="flex gap-3">
          <span class="mt-1 shrink-0 text-primary" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span>{highlightsTalks}</span>
        </li>
        <li class="flex gap-3">
          <span class="mt-1 shrink-0 text-primary" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span>{highlightsPartners}</span>
        </li>
      </ul>
    </div>
  </div>
</section>
