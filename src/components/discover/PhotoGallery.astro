---
import { Image } from "astro:assets";
import landscape01 from "@/assets/photos/selection-2027/landscape-01.jpg";
import landscape02 from "@/assets/photos/selection-2027/landscape-02.jpg";
import landscape03 from "@/assets/photos/selection-2027/landscape-03.jpg";
import landscape04 from "@/assets/photos/selection-2027/landscape-04.jpg";
import landscape05 from "@/assets/photos/selection-2027/landscape-05.jpg";
import landscape06 from "@/assets/photos/selection-2027/landscape-06.jpg";
import portrait01 from "@/assets/photos/selection-2027/portrait-01.jpg";
import portrait02 from "@/assets/photos/selection-2027/portrait-02.jpg";
import portrait03 from "@/assets/photos/selection-2027/portrait-03.jpg";

interface Props {
  title: string;
  closeLabel: string;
  prevLabel: string;
  nextLabel: string;
  albumLabel: string;
  albumUrl: string;
}

const { title, closeLabel, prevLabel, nextLabel, albumLabel, albumUrl } = Astro.props;

// Row-major arrangement on the 3-column desktop grid: row 1 = 3 landscape,
// row 2 = 3 portrait, row 3 = 3 landscape. Every column then holds 2 landscape
// + 1 portrait, and each photo is shown in full at its native aspect ratio.
type Photo = { src: ImageMetadata; alt: string; orientation: "landscape" | "portrait" };
const photos: Photo[] = [
  { src: landscape01, alt: "Hall principal de Cloud Native Days France 2026, vue d'ensemble", orientation: "landscape" },
  { src: landscape02, alt: "Networking entre praticien(ne)s à Cloud Native Days France 2026", orientation: "landscape" },
  { src: landscape03, alt: "Auditorium pendant une conférence à Cloud Native Days France 2026", orientation: "landscape" },
  { src: portrait01, alt: "Vue verticale de l'événement Cloud Native Days France 2026", orientation: "portrait" },
  { src: portrait02, alt: "Intervenant(e) en pleine présentation à Cloud Native Days France 2026", orientation: "portrait" },
  { src: portrait03, alt: "Intervenant(e) à Cloud Native Days France 2026", orientation: "portrait" },
  { src: landscape04, alt: "Audience attentive lors d'une session de Cloud Native Days France 2026", orientation: "landscape" },
  { src: landscape05, alt: "Ambiance d'une keynote à Cloud Native Days France 2026", orientation: "landscape" },
  { src: landscape06, alt: "Moment d'échange à Cloud Native Days France 2026", orientation: "landscape" },
];
---

<section id="photos" class="mx-auto max-w-7xl px-4 md:px-6 py-16">
  <h2 class="text-3xl font-bold text-foreground mb-8 text-center">{title}</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {photos.map(({ src, alt, orientation }, i) => (
      <button
        class:list={[
          "gallery-btn w-full rounded-lg overflow-hidden block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
          orientation === "landscape" ? "aspect-[3/2]" : "aspect-[2/3]",
        ]}
        data-index={String(i)}
        aria-label={alt}
      >
        <Image
          src={src}
          alt={alt}
          widths={[400, 800, 1200]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-300"
        />
      </button>
    ))}
  </div>

  <div class="mt-10 text-center">
    <a
      href={albumUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-md border-2 border-primary-strong text-primary-strong bg-transparent text-base font-semibold hover:bg-primary/10 hover:shadow-[0_0_0_4px_oklch(62.5%_0.162_259.9_/_0.15)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background transition-[background-color,box-shadow] duration-150"
    >
      {albumLabel}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <dialog
    id="gallery-lightbox"
    class="fixed inset-0 z-50 bg-black/90 w-full max-w-none h-full m-0 p-0 backdrop:bg-transparent"
    aria-label={title}
  >
    <div class="flex items-center justify-center w-full h-full relative p-4">
      <button
        id="lb-close"
        class="absolute top-4 right-4 text-white text-2xl w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/20 transition-colors"
        aria-label={closeLabel}
      >&#x2715;</button>
      <button
        id="lb-prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl w-12 h-12 flex items-center justify-center rounded-full hover:bg-white/20 transition-colors"
        aria-label={prevLabel}
      >&#x2039;</button>
      <img id="lb-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain rounded-lg" />
      <button
        id="lb-next"
        class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-4xl w-12 h-12 flex items-center justify-center rounded-full hover:bg-white/20 transition-colors"
        aria-label={nextLabel}
      >&#x203a;</button>
    </div>
  </dialog>
</section>

<script>
  (function () {
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-btn"));
    const dialog = document.getElementById("gallery-lightbox") as HTMLDialogElement | null;
    const lbImg = document.getElementById("lb-img") as HTMLImageElement | null;

    if (!dialog || !lbImg) return;

    const srcs = btns.map((btn) => (btn.querySelector("img") as HTMLImageElement).src);
    const alts = btns.map((btn) => (btn.querySelector("img") as HTMLImageElement).alt);
    let current = 0;

    function showSlide(i: number) {
      current = (i + srcs.length) % srcs.length;
      lbImg!.src = srcs[current];
      lbImg!.alt = alts[current];
    }

    btns.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        showSlide(i);
        dialog!.showModal();
      });
    });

    document.getElementById("lb-close")?.addEventListener("click", () => dialog!.close());
    document.getElementById("lb-prev")?.addEventListener("click", () => showSlide(current - 1));
    document.getElementById("lb-next")?.addEventListener("click", () => showSlide(current + 1));

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") showSlide(current - 1);
      if (e.key === "ArrowRight") showSlide(current + 1);
    });
  })();
</script>
