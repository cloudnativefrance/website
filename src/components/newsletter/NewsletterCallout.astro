---
/**
 * Site-wide newsletter callout band.
 *
 * Rendered by Layout.astro between the page content and the footer, on every
 * route except the legal pages and ComingSoonLayout (which is itself a
 * newsletter appeal). Consolidates what used to be five scattered entry points
 * in three different wordings and two colour treatments.
 *
 * The CTA links out to the hosted Brevo form rather than embedding an email
 * field: the build is fully static, so an inline form would mean a React island
 * posting cross-origin to sibforms.com plus GDPR consent, submission states and
 * anti-bot handling. See docs/superpowers/specs/2026-07-25-newsletter-callout-design.md.
 *
 * Shaped in Stitch first (project "Cloud Native Days France 2027", screen
 * 629de73859f14848b9881e605f04b384), then reworked against the rendered page:
 * a contained card read as one more card at the end of the document, because
 * --card sits 2.5% in lightness from --background. It is now a full-bleed band
 * on --secondary with a structural top rule, the same idiom as ReplayGrid and
 * DiscoverValues. That buys separation without buying height — the block is
 * shorter than the card version it replaces.
 */
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import type { Locale } from "@/i18n/ui";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { NEWSLETTER_URL } from "@/lib/event";

interface Props {
  lang?: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const resolvedLang = (lang ?? getLangFromUrl(Astro.url)) as Locale;
const t = useTranslations(resolvedLang);
---

<section
  aria-labelledby="newsletter-callout-heading"
  class:list={["border-t border-border bg-secondary", className]}
>
  <div
    class="mx-auto max-w-7xl px-4 md:px-6 py-10 grid gap-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16"
  >
    <div class="flex flex-col items-start gap-2">
      <h2
        id="newsletter-callout-heading"
        class="text-2xl md:text-3xl font-bold leading-tight tracking-[-0.02em] text-balance text-foreground"
      >
        {t("newsletter.heading")}
      </h2>
      <p class="max-w-[55ch] text-base leading-[1.6] text-pretty text-muted-foreground">
        {t("newsletter.body")}
      </p>
    </div>

    <div class="flex flex-col items-stretch gap-3 md:items-end">
      <a
        href={NEWSLETTER_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t("newsletter.cta_aria")}
        class={cn(
          buttonVariants({ variant: "outline", size: "lg" }),
          "h-14 px-6 text-lg font-semibold",
          // Solid red fill. The text pairing is computed, not eyeballed, and
          // asserted in src/lib/__tests__/contrast.test.ts: on the light
          // --destructive-strong fill (L=54%) white clears AA at 5.66:1, but
          // the same white on the dark fill (L=68%) is 3.16:1 — a fail — so
          // dark mode paints --background on the fill instead: 6.12:1.
          // The dark: overrides remain mandatory: the outline variant's
          // dark:bg-input/30 outranks plain classes via `:is(.dark *)`.
          "border-2 border-transparent bg-destructive-strong text-destructive-foreground",
          "dark:border-transparent dark:bg-destructive-strong dark:text-background",
          // Hover moves the fill AWAY from the label, never toward it: darken
          // in light (more room under white text), lighten in dark (more room
          // under the near-black label). Same color-mix idiom as the glow.
          "hover:bg-[color-mix(in_oklab,var(--color-destructive-strong)_88%,black)] hover:text-destructive-foreground",
          "dark:hover:bg-[color-mix(in_oklab,var(--color-destructive-strong)_88%,white)] dark:hover:text-background",
          "hover:shadow-[0_0_0_4px_color-mix(in_oklab,var(--destructive-strong)_15%,transparent)]",
          "focus-visible:ring-destructive-strong/50",
          "gap-2"
        )}
      >
        <svg
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0"
        >
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        {t("newsletter.cta")}
      </a>
      <p
        class="max-w-[40ch] text-xs leading-[1.5] text-pretty text-muted-foreground md:text-right"
      >
        {t("newsletter.note")}
      </p>
    </div>
  </div>
</section>
