---
import type { Locale } from "@/i18n/ui";
import { useTranslations, getLocalePath } from "@/i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactHref = getLocalePath(lang, "/contact");
---

<section class="py-16">
  <div class="max-w-[640px] mx-auto text-center px-4">
    <h2 class="text-2xl font-semibold text-foreground">{t("sponsors.cta.heading")}</h2>
    <p class="text-base text-muted-foreground mt-4">{t("sponsors.cta.body")}</p>
    <a
      href={contactHref}
      class="inline-flex items-center justify-center h-[52px] rounded-md border-2 border-destructive-strong text-destructive-strong bg-transparent text-lg font-bold px-8 mt-8 transition-[color,background-color,border-color,box-shadow] duration-150 hover:bg-destructive-strong/10 hover:text-destructive-strong hover:border-destructive-strong hover:shadow-[0_0_0_4px_color-mix(in_oklab,var(--destructive-strong)_15%,transparent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive-strong/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      {t("sponsors.cta.button")}
    </a>
  </div>
</section>
