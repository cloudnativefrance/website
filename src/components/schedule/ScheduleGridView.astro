---
// src/components/schedule/ScheduleGridView.astro
import type { SessionRow } from "@/lib/schedule";
import { listRooms } from "@/lib/schedule";
import { findGaps, groupIntoSlots } from "@/lib/schedule-filter";
import SessionCard from "./SessionCard.astro";
import type { Locale } from "@/i18n/ui";
import { useTranslations, getLocalePath } from "@/i18n/utils";

interface SpeakerInfo { name: string; company?: string }
interface Props { sessions: SessionRow[]; lang: Locale; speakerInfo: Map<string, SpeakerInfo> }

const { sessions, lang, speakerInfo } = Astro.props;
const t = useTranslations(lang);
const rooms = listRooms(sessions);
const slots = groupIntoSlots(sessions);
const gaps = findGaps(slots);
const gapAfter = new Map(gaps.map((g) => [g.afterSlotIndex, g]));

function linksFor(s: SessionRow) {
  return s.speakers.map((ref) => {
    const info = speakerInfo.get(ref);
    return {
      label: info?.name ?? ref,
      company: info?.company,
      href: info?.name ? getLocalePath(lang, `/speakers/${ref}`) : null,
    };
  });
}
---

<div class="grid-view" style={`--room-count:${rooms.length};`}>
  <div class="grid-view-head">
    <div class="grid-view-gutter"></div>
    {rooms.map((room) => <div class="grid-view-room">{room}</div>)}
  </div>

  {slots.map((slot, i) => {
    const hasKeynote = slot.sessions.some((s) => s.format === "keynote");
    const hasNonKeynote = slot.sessions.some((s) => s.format !== "keynote");
    // The keynote span and the room cells are ONE array expression, not two
    // sibling `{}` template blocks: two siblings put a source newline between
    // them that Astro renders as a stray whitespace text node even when one
    // side evaluates to `false` — which would break the byte-identical output
    // a homogeneous slot (keynote-only or non-keynote-only, i.e. every slot
    // today) must keep.
    return (
    <>
      <div class="grid-view-row">
        <div class="grid-view-gutter grid-view-time">
          {slot.startTime.slice(11, 16)}
        </div>
        {[
          hasKeynote && (
            <div class="grid-view-span">
              {slot.sessions
                .filter((s) => s.format === "keynote")
                .map((s) => (
                  <SessionCard session={s} lang={lang} speakers={linksFor(s)} variant="grid" />
                ))}
            </div>
          ),
          hasNonKeynote &&
            // Explicit column, not auto-placement: when this row also renders
            // `.grid-view-span` (grid-column: 2 / -1, filling row 1), the auto
            // placement algorithm can't fit a cell after it on row 1 and wraps
            // to row 2 starting back at column 1 — the gutter's column, not
            // room 0's. Every cell then lands one column left of its room,
            // silently (the room[last] column is left empty instead). The
            // gutter is column 1, so room index `i` is always column `i + 2`.
            rooms.map((room, i) => (
              <div class="grid-view-cell" style={`grid-column:${i + 2};`}>
                {slot.sessions
                  .filter((s) => s.room === room && s.format !== "keynote")
                  .map((s) => (
                    <SessionCard session={s} lang={lang} speakers={linksFor(s)} variant="grid" />
                  ))}
              </div>
            )),
        ]}
      </div>
      {gapAfter.has(i) && (
        <div class="grid-view-break">
          <span>
            {gapAfter.get(i)!.minutes >= 40 ? t("schedule.break.lunch") : t("schedule.break.label")}
            {" · "}
            {gapAfter.get(i)!.startTime} — {gapAfter.get(i)!.endTime}
          </span>
        </div>
      )}
    </>
    );
  })}
</div>

<style>
  .grid-view { display: flex; flex-direction: column; gap: 10px; }
  .grid-view-head,
  .grid-view-row {
    display: grid;
    grid-template-columns: 56px repeat(var(--room-count), minmax(0, 1fr));
    gap: 10px;
    /* Cells stretch by default, so every card in a row shares a height without
       any JS — which is what removes the ragged whitespace of the old grid. */
    align-items: stretch;
  }
  .grid-view-head { position: sticky; top: 64px; z-index: 10; background: var(--color-background); padding: 8px 0; }
  .grid-view-room {
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    text-align: center; color: var(--color-foreground);
  }
  .grid-view-gutter { min-width: 0; }
  .grid-view-time {
    font-size: 12px; color: var(--color-muted-foreground);
    font-variant-numeric: tabular-nums; padding-top: 12px;
  }
  .grid-view-cell { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  /* The cell (a grid item) stretches to the row's height by default, but a
     flex column never grows its own child along the main axis on its own —
     without this, a shorter card would sit top-aligned inside a taller cell
     instead of matching its tallest sibling's height. `:global()` is required:
     SessionCard.astro carries its own Astro style scope, so an unscoped
     selector is the only way this rule can reach it (see the two resolutions
     in the task brief for the identical issue in the list view).
     Basis is `auto`, not `0`: with a `0` basis the flex algorithm ignores each
     card's content height and splits the cell equally between children, which
     is fine for one card (it still grows to fill the cell) but would force two
     stacked cards to identical heights regardless of their own content. */
  .grid-view-cell > :global(.session-card) { flex: 1 1 auto; }
  /* Same column-flex-and-gap treatment as .grid-view-cell, so two keynote-format
     sessions in one slot stack with a gap instead of as bare abutting blocks. */
  .grid-view-span { display: flex; flex-direction: column; gap: 8px; grid-column: 2 / -1; }
  .grid-view-break {
    display: flex; align-items: center; gap: 12px;
    font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    color: var(--color-muted-foreground);
  }
  .grid-view-break::before,
  .grid-view-break::after { content: ""; flex: 1; height: 1px; background: var(--color-border); }

  .grid-view-row.is-hidden { display: none; }

  /* Below md the room columns are unusable, and the list view takes over. */
  @media (max-width: 767px) { .grid-view { display: none; } }
</style>
