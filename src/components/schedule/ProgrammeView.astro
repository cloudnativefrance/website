---
/**
 * The Programme page itself, for the real routes (/programme/[year]) and the
 * demo (/programme/demo/[phase]) alike. Presentational only: the ROUTES load
 * the data, behind `isEditionLoadable`, so the edition gate stays where
 * tests/build/edition-gating.test.ts can see it. An edition whose programme
 * is not announced gets the "being built" page and no data at all.
 */
import Layout from "@/layouts/Layout.astro";
import ComingNotice from "@/components/ComingNotice.astro";
import DemoBar from "@/components/cfp/DemoBar.astro";
import ProgrammeBuilding from "./ProgrammeBuilding.astro";
import ScheduleGrid from "./ScheduleGrid.astro";
import ScheduleParcours from "./ScheduleParcours.astro";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { CURRENT_EDITION, type Edition } from "@/lib/editions";
import type { ProgrammePhase } from "@/lib/programme-phase";
import { programmeDemosEnabled } from "@/lib/programme/demo";
import { getProgrammeMetadata, type SessionRow } from "@/lib/schedule";
import { getSlug, type SpeakerEntry } from "@/lib/speakers";
import type { EventTrack } from "@/lib/tracks";

interface Props {
  lang: Locale;
  year: Edition;
  phase: ProgrammePhase;
  sessions: SessionRow[];
  speakerEntries: SpeakerEntry[];
  eventTracks: EventTrack[];
  /** A demo page: noindex, and the DÉMO switcher marks its phase. */
  simulated?: boolean;
}

const {
  lang,
  year,
  phase,
  sessions,
  speakerEntries,
  eventTracks,
  simulated = false,
} = Astro.props;
const t = useTranslations(lang);
// Only an upcoming edition has phases to preview; a finished one is just its
// programme.
const demos = year > CURRENT_EDITION && programmeDemosEnabled();

// Build a lookup map keyed by BOTH slug and full name. Every current session
// source already resolves to slugs (the Pretalx resolver guarantees one or
// throws; the frozen 2023 archive stores slugs too), so the name key is a
// harmless safety net rather than a live requirement — see the matching
// comment on ScheduleGrid's speakerInfo prop. Each value carries the
// canonical display name + (optional) company so the schedule cards can
// render "Name (Company)" without extra fetching.
const speakerInfo = new Map<string, { name: string; company?: string }>();
for (const s of speakerEntries) {
  const info = { name: s.data.name, company: s.data.company };
  speakerInfo.set(getSlug(s.id), info);
  speakerInfo.set(s.data.name, info);
}

const { railLabel, subtitle, programmePdfUrl, programmePdfLabel } =
  getProgrammeMetadata(year, lang);

// The site-wide newsletter band only under a real programme: the "being
// built" page carries its own CTA (the CFP, or the newsletter itself once the
// call has closed), and a second pitch under it competes — CfpPage's rule.
const band = phase === "announced";
---

<Layout
  title={`${t("schedule.heading")} ${year} | ${t("site.title")}`}
  newsletter={band}
  noindex={simulated}
  programmePhase={simulated ? phase : undefined}
>
  {
    demos && (
      <DemoBar
        lang={lang}
        section="programme"
        phase={phase}
        simulated={simulated}
      />
    )
  }
  {
    phase !== "announced" ? (
      <ProgrammeBuilding lang={lang} year={year} phase={phase} />
    ) : (
      <main
        class="px-4 md:px-6 lg:px-8"
        data-schedule-active-singular={t("schedule.filter.active_singular")}
        data-schedule-active-plural={t("schedule.filter.active_plural")}
      >
        {sessions.length === 0 ? (
          <section class="mx-auto max-w-3xl pt-16 pb-20 text-center md:pt-24">
            <p
              class="text-xs font-semibold tracking-[0.2em] uppercase"
              style="color: var(--color-primary, #4985e8);"
            >
              {railLabel}
            </p>
            <h1
              class="text-foreground mt-3 text-4xl font-bold tracking-tight md:text-5xl"
              style="letter-spacing:-0.02em;"
            >
              {`${t("schedule.heading")} ${year}`}
            </h1>
            <p class="text-muted-foreground mt-6 text-base md:text-lg">
              {t("schedule.empty_state")}
            </p>
          </section>
        ) : (
          <>
            <section class="schedule-section mx-auto max-w-7xl pt-16 pb-6 md:pt-20">
              {year === CURRENT_EDITION && (
                <ComingNotice class="mx-auto mb-8 max-w-6xl" />
              )}
              <p
                class="text-xs font-semibold tracking-[0.2em] uppercase"
                style="color: var(--color-primary, #4985e8);"
              >
                {railLabel}
              </p>
              {/* Title and subtitle on the left, parcours on the right, bottom
                aligned so the two blocks share a baseline instead of the strip
                floating beside a three-line paragraph. Stacks below lg: seven
                labels and a 5xl heading do not share 1024px. */}
              <div class="mt-3 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
                <div class="min-w-0">
                  <h1
                    class="text-foreground text-4xl font-bold tracking-tight md:text-5xl"
                    style="letter-spacing:-0.02em;"
                  >
                    {`${t("schedule.heading")} ${year}`}
                  </h1>
                  <p class="text-muted-foreground mt-3 max-w-2xl text-base md:text-lg">
                    {subtitle}
                  </p>
                </div>
                <ScheduleParcours tracks={eventTracks} lang={lang} />
              </div>
              {programmePdfUrl && (
                <a
                  href={programmePdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-destructive-strong text-destructive-strong hover:bg-destructive-strong/10 focus-visible:ring-destructive-strong/50 mt-5 inline-flex h-11 items-center justify-center gap-2 rounded-md border-2 bg-transparent px-5 text-base font-semibold focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
                >
                  <svg
                    aria-hidden="true"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  {programmePdfLabel}
                </a>
              )}
            </section>
            <section class="schedule-section mx-auto max-w-7xl pb-20">
              <ScheduleGrid
                sessions={sessions}
                lang={lang}
                speakerInfo={speakerInfo}
                year={year}
              />
            </section>
          </>
        )}
      </main>
    )
  }
</Layout>
