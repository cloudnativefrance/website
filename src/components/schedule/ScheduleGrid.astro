---
import type { SessionRow } from "@/lib/schedule";
import { hasBothAudiences } from "@/lib/audience";
import ScheduleToolbar from "./ScheduleToolbar.astro";
import ScheduleGridView from "./ScheduleGridView.astro";
import ScheduleListView from "./ScheduleListView.astro";
import SessionModal from "./SessionModal.astro";
import AgendaDrawer from "./AgendaDrawer.astro";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface SpeakerInfo {
  name: string;
  company?: string;
}

interface Props {
  sessions: SessionRow[];
  lang: Locale;
  /**
   * Map of speaker reference → display info. Keyed by both slug and full
   * name. In practice every current source already resolves to slugs — the
   * Pretalx resolver in `src/lib/pretalx.ts` guarantees a slug or throws, and
   * the frozen pre-Pretalx archive (2023) stores slugs too — but the extra
   * name key costs nothing and stays as a safety net should a future source
   * not make that guarantee.
   */
  speakerInfo: Map<string, SpeakerInfo>;
}

const { sessions, lang, speakerInfo } = Astro.props;
const t = useTranslations(lang);

/**
 * Which view opens first.
 *
 * Grid, for every edition. This used to branch on whether the event had
 * already happened, on the reasoning that a past edition is browsed for a
 * replay where the room is noise. That reasoning was really about the grid
 * being bad: it stretched every card in a slot to one height, so it neither
 * showed durations nor saved space. Now that concurrent cards are ordered by
 * duration — rows are content-sized, so heights are not proportional across the
 * whole day, only honest where a visitor actually compares them —
 * the grid is both the more informative view and about half the height of the
 * list (4809px against 9386px on the 2026 day), which leaves the branch with
 * nothing to buy. The list is one click away, remembered per visitor, and
 * still the only view below md where the room columns cannot fit.
 */
const defaultView = "grid" as const;
---

<div
  data-schedule-root
  data-default-view={defaultView}
  data-has-audiences={hasBothAudiences(sessions) ? "true" : "false"}
  data-count-template={t("schedule.results.count")}
  data-none-label={t("schedule.results.none")}
  data-schedule-format-keynote={t("schedule.format.keynote")}
  data-schedule-format-talk={t("schedule.format.talk")}
  data-schedule-format-lightning={t("schedule.format.lightning")}
  data-schedule-format-workshop={t("schedule.format.workshop")}
  data-schedule-level-beginner={t("schedule.level.beginner")}
  data-schedule-level-intermediate={t("schedule.level.intermediate")}
  data-schedule-level-advanced={t("schedule.level.advanced")}
  data-schedule-agenda-remove={t("schedule.agenda.remove")}
  data-schedule-empty={t("schedule.agenda.empty")}
>
  <ScheduleToolbar sessions={sessions} lang={lang} defaultView={defaultView} />
  <div class="schedule-views">
    <ScheduleGridView sessions={sessions} lang={lang} speakerInfo={speakerInfo} />
    <ScheduleListView sessions={sessions} lang={lang} speakerInfo={speakerInfo} />
  </div>
</div>

<SessionModal lang={lang} />
<AgendaDrawer lang={lang} />

<script>
  import "./schedule-ui.ts";
</script>

<style>
  .schedule-views { margin-top: 18px; }
</style>
