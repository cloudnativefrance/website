---
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!--
  Session detail modal, opened with showModal() so it renders in the top layer.

  A native <dialog>, not a hand-rolled `fixed inset-0` overlay: a fixed element
  is laid out against the layout viewport, and on mobile Chrome that decouples
  from what the visitor actually sees (page zoom, dynamic toolbar), which
  pinned the panel to a screen corner and cut it off. The top layer is
  positioned by the browser itself and cannot land outside the visual viewport;
  it also makes everything behind the dialog inert, replacing the manual
  aria-modal / focus-trap / Escape wiring.

  `tabindex="-1"` is the focus target on open: aria-labelledby makes focusing
  this element announce the session title and the dialog role, where focusing
  the X button would announce only "Close, button".
-->
<dialog
  id="schedule-session-modal"
  tabindex="-1"
  aria-labelledby="schedule-session-modal-title"
  class="border-border bg-card w-[calc(100%-2rem)] max-w-2xl overflow-auto rounded-2xl border p-0 shadow-2xl md:w-[calc(100%-3rem)]"
>
  <div
    class="border-border/70 flex items-start justify-between gap-3 border-b px-6 pt-6 pb-4"
  >
    <div
      class="flex flex-wrap items-center gap-2"
      id="schedule-session-modal-meta-top"
    >
      <!-- filled by JS: format chip, time pill, room pill, level pill -->
    </div>
    <button
      type="button"
      data-close-modal
      class="text-muted-foreground hover:bg-muted hover:text-foreground inline-flex h-9 w-9 items-center justify-center rounded-md"
      aria-label={t("schedule.close")}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M18 6L6 18"></path><path d="M6 6l12 12"></path></svg
      >
    </button>
  </div>
  <img
    id="schedule-session-modal-cover"
    alt=""
    class="border-border/70 hidden aspect-[16/7] w-full border-b object-cover"
  />
  <div class="space-y-5 px-6 py-5">
    <h2
      id="schedule-session-modal-title"
      class="text-foreground text-2xl leading-tight font-bold md:text-3xl"
      style="letter-spacing:-0.02em;"
    >
    </h2>
    <div
      id="schedule-session-modal-speakers"
      class="flex flex-wrap gap-2 text-sm"
    >
    </div>
    <div id="schedule-session-modal-tags" class="flex flex-wrap gap-2"></div>
    <div
      id="schedule-session-modal-description"
      class="text-base leading-relaxed"
      style="color: var(--color-foreground);"
    >
    </div>
    <div
      id="schedule-session-modal-actions"
      class="flex flex-wrap items-center gap-2 pt-2"
    >
      <button
        type="button"
        id="schedule-session-modal-bookmark"
        class="border-border bg-background/60 text-foreground hover:border-primary/60 inline-flex h-9 items-center gap-2 rounded-md border px-3 text-sm font-medium"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"></path></svg
        >
        <span data-bookmark-label>{t("schedule.bookmark_toggle")}</span>
      </button>
      <a
        id="schedule-session-modal-feedback"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="border-primary/50 text-primary hover:bg-primary/10 hidden inline-flex h-9 items-center gap-2 rounded-md border bg-transparent px-3 text-sm font-medium"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg
        >
        {t("schedule.open_feedback")}
      </a>
      <a
        id="schedule-session-modal-slides"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="border-border bg-background/60 text-foreground hover:border-primary/60 hidden inline-flex h-9 items-center gap-2 rounded-md border px-3 text-sm font-medium"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="3" y="4" width="18" height="14" rx="2"></rect><path
            d="M8 21h8"></path><path d="M12 18v3"></path></svg
        >
        {t("schedule.open_slides")}
      </a>
      <a
        id="schedule-session-modal-recording"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="border-border bg-background/60 text-foreground hover:border-primary/60 hidden inline-flex h-9 items-center gap-2 rounded-md border px-3 text-sm font-medium"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polygon points="23 7 16 12 23 17 23 7"></polygon><rect
            x="1"
            y="5"
            width="15"
            height="14"
            rx="2"></rect></svg
        >
        {t("schedule.open_recording")}
      </a>
    </div>
  </div>
</dialog>

<style is:global>
  /*
   * Modal description: markdown-rendered paragraphs + inline elements.
   *
   * `is:global`, not scoped: schedule-ui.ts fills #schedule-session-modal-
   * description via innerHTML at runtime, so this content is never part of
   * Astro's render of this component — a scoped rule compiles to (e.g.)
   * `#schedule-session-modal-description[data-astro-cid-x] p[data-astro-cid-x]`,
   * which the injected <p> tags can never match, since they don't carry that
   * attribute. The container's own id already keeps this from leaking
   * anywhere else on the page.
   */
  #schedule-session-modal-description p + p {
    margin-top: 0.75em;
  }
  #schedule-session-modal-description strong {
    color: var(--color-foreground);
    font-weight: 700;
  }
  #schedule-session-modal-description em {
    font-style: italic;
  }
  #schedule-session-modal-description code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background-color: color-mix(
      in oklch,
      var(--color-background) 60%,
      transparent
    );
    color: var(--color-foreground);
  }
  #schedule-session-modal-description a {
    color: var(--color-primary);
    text-decoration: none;
  }
  #schedule-session-modal-description a:hover {
    text-decoration: underline;
  }

  /*
   * Top-layer positioning. The UA stylesheet's legacy `max-width` and padding
   * on dialog would shrink and inset the panel; the utilities above already
   * override both, but centering and the height cap are stated here because
   * they must win over the UA sheet in one place. `dvh` tracks the dynamic
   * toolbar where a bare `vh` left the bottom controls under Chrome's URL bar.
   */
  #schedule-session-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    max-height: 85vh;
    max-height: 85dvh;
  }
  #schedule-session-modal::backdrop {
    background-color: color-mix(
      in oklab,
      var(--color-background) 80%,
      transparent
    );
    backdrop-filter: blur(4px);
  }
</style>

<style>
  /* Modal bookmark button on-state — this button is static markup rendered
     by this component, so a scoped rule reaches it fine. */
  #schedule-session-modal-bookmark.is-on {
    color: var(--color-primary);
    border-color: color-mix(in oklch, var(--color-primary) 50%, transparent);
    background-color: color-mix(
      in oklch,
      var(--color-primary) 10%,
      transparent
    );
  }
  #schedule-session-modal-bookmark.is-on svg {
    fill: currentColor;
  }
</style>
