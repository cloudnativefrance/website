# Local development only. Copy to .env.local and fill in.
# .env* is gitignored — never commit a real token.
#
# Pretalx API token, for the reads that are not public: speaker company/role/
# social links, and the talk level. Create one at
#   https://cfp.cloudnativedays.fr/orga/me
# scoped to the event, with read access to `questions` and `answers`.
#
# Without it, `pnpm dev` and `pnpm build` still work — they warn and render
# speakers with no affiliation and a schedule with no level chips. The
# production image sets PRETALX_TOKEN_REQUIRED=1 so a release cannot ship that.
PRETALX_API_TOKEN=

# Override the Pretalx instance (defaults to https://cfp.cloudnativedays.fr).
# PRETALX_BASE_URL=
